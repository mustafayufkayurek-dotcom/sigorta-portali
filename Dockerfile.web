# ─── Stage 1: Dependencies ────────────────────────────────────────────────────
FROM node:20-alpine AS deps
RUN apk add --no-cache libc6-compat python3 make g++
WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@8.15.1 --activate

# Copy workspace manifests
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/

# Install all dependencies
RUN pnpm install --frozen-lockfile

# ─── Stage 2: Build shared package ────────────────────────────────────────────
FROM deps AS shared-build
COPY tsconfig.base.json ./
COPY packages/shared/ ./packages/shared/
RUN pnpm --filter @sigorta/shared build

# ─── Stage 3: Build Next.js app ───────────────────────────────────────────────
FROM shared-build AS web-build
COPY apps/web/ ./apps/web/
RUN find ./apps/web -name '._*' -delete && find ./apps/web -name '.DS_Store' -delete

ARG NEXT_PUBLIC_API_URL=https://app.meridyen-tr.com/api/v1
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

# Ensure standalone output
WORKDIR /app/apps/web
# .env.local laptop API adresini derlemeye gömer; ARG/ENV kazansın
RUN rm -f .env .env.local .env.development.local .env.production.local
RUN rm -rf .next
ENV NODE_OPTIONS=--max-old-space-size=4096
RUN pnpm run build

# ─── Stage 4: Production image ────────────────────────────────────────────────
FROM node:20-alpine AS production
RUN apk add --no-cache wget dumb-init
WORKDIR /app

ENV NODE_ENV=production
ARG NEXT_PUBLIC_API_URL=https://app.meridyen-tr.com/api/v1
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV PORT=3001
ENV HOSTNAME="0.0.0.0"

# Copy standalone output
COPY --from=web-build /app/apps/web/.next/standalone ./
COPY --from=web-build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=web-build /app/apps/web/public ./apps/web/public

EXPOSE 3001

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "apps/web/server.js"]
