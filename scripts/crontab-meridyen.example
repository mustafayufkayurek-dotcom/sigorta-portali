# Meridyen canlı sunucu — örnek crontab (root)
# Kurulum: crontab -e → aşağıdaki satırları ekle
# Eski /opt/sigorta yollarını KALDIR

# Gece DB yedeği (02:00)
0 2 * * * /opt/app/scripts/backup.sh >> /var/log/meridyen-backup.log 2>&1

# Yedek sağlık kontrolü (her gün 02:30)
30 2 * * * /opt/app/scripts/verify-backup-health.sh >> /var/log/meridyen-backup-health.log 2>&1

# Haftalık güvenli disk bakımı (Pazar 03:00)
0 3 * * 0 /opt/app/scripts/server-disk-maintenance.sh >> /var/log/meridyen-disk.log 2>&1

# Haftalık güvenlik denetimi (Pazartesi 04:00 — salt okunur)
0 4 * * 1 /opt/app/scripts/server-security-audit.sh >> /var/log/meridyen-security-audit.log 2>&1
