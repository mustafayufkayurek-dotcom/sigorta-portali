# Backend yerel örnek. Tam liste kök .env.example dosyasındadır.
# Gerçek şifre yazılmaz. Canlı değerler VPS .env.production içindedir.
CACHE_ENABLED=false
BACKEND_PORT=3000
WEB_URL=http://localhost:3001
JWT_SECRET=CHANGE_ME_LONG_RANDOM
