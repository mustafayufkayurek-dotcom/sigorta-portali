  // P&L Faz 3 — Gelir kırılımı
  fileFeeRevenue      Float @default(0) @map("file_fee_revenue")       // Dosya bedeli (sigortacıdan)
  extraWorkRevenue    Float @default(0) @map("extra_work_revenue")     // Ekstra iş (sigortalıdan)
  totalRevenue        Float @default(0) @map("total_revenue")
  // P&L Faz 3 — Gider kırılımı
