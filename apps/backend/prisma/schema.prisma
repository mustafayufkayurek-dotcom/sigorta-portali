model VendorDiscoverySession {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  city        String
  district    String?
  serviceType String   @map("service_type")
  minRating   Float?   @map("min_rating")
  source      String   @default("google_places")
  resultCount Int      @map("result_count")
  createdAt   DateTime @default(now()) @map("created_at")

  user       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidates VendorDiscoveryCandidate[]

  @@index([userId, createdAt])
  @@map("vendor_discovery_sessions")
}

model VendorDiscoveryCandidate {
  id               String   @id @default(uuid())
  sessionId        String   @map("session_id")
  externalId       String   @map("external_id")
  name             String
  address          String?
  phone            String?
  rating           Float?
  reviewCount      Int?     @map("review_count")
  latitude         Float?
  longitude        Float?
  source           String
  rawPayload       Json?    @map("raw_payload")
  importedVendorId String?  @map("imported_vendor_id")
  createdAt        DateTime @default(now()) @map("created_at")

  session        VendorDiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  importedVendor Vendor?              @relation("ImportedDiscoveryVendor", fields: [importedVendorId], references: [id])

  @@unique([sessionId, externalId])
  @@index([sessionId])
  @@map("vendor_discovery_candidates")
}

// Marangoz Keşif Ölçüsü — Faz 1
model FieldSurveyBrief {
  id                String   @id @default(uuid())
  claimFileId       String   @map("claim_file_id")
  createdByUserId   String   @map("created_by_user_id")
  itemType          String   @map("item_type")
  // mutfak_alt_modul | kapi | lavabo_alt | ada_tezgah | parke | diger
  title             String
  summaryText       String   @map("summary_text")
  dimensionsJson    Json     @map("dimensions_json")
  materialsJson     Json     @map("materials_json")
  aiConfidence      Float?   @map("ai_confidence")
  isEstimated       Boolean  @default(true) @map("is_estimated")
  photoUrl          String?  @map("photo_url")
  annotatedPhotoUrl String?  @map("annotated_photo_url")
  status            String   @default("draft")
  // draft | sent
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  claimFile     ClaimFile @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  createdByUser User      @relation(fields: [createdByUserId], references: [id])

  @@index([claimFileId, createdAt])
  @@index([createdByUserId])
  @@map("field_survey_briefs")
}

/// AI + AR Akıllı Ölçüm — yapı elemanı (Evidence Chain kökü). Soft archive; hard delete yok.
model SmartMeasureElement {
  id               String    @id @default(uuid())
  claimFileId      String    @map("claim_file_id")
  /// draft | measured | reviewed | approved | archived
  status           String    @default("draft")
  locationLabel    String?   @map("location_label")
  roomLabel        String?   @map("room_label")
  elementType      String    @map("element_type")
  title            String
  createdByUserId  String    @map("created_by_user_id")
  archivedAt       DateTime? @map("archived_at")
  archivedByUserId String?   @map("archived_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  claimFile      ClaimFile             @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  createdByUser  User                  @relation("SmartMeasureElementCreatedBy", fields: [createdByUserId], references: [id])
  archivedByUser User?                 @relation("SmartMeasureElementArchivedBy", fields: [archivedByUserId], references: [id])
  versions       SmartMeasureVersion[]

  @@index([claimFileId, createdAt], map: "idx_sme_claim_created")
  @@index([claimFileId, status], map: "idx_sme_claim_status")
  @@index([createdByUserId], map: "idx_sme_created_by")
  @@index([elementType], map: "idx_sme_element_type")
  @@index([archivedAt], map: "idx_sme_archived")
  @@map("smart_measure_elements")
}

/// Akıllı ölçüm sürümü — append-only Evidence; mm integer; FileAsset foto.
model SmartMeasureVersion {
  id                        String   @id @default(uuid())
  claimFileId               String   @map("claim_file_id")
  elementId                 String   @map("element_id")
  versionNo                 Int      @map("version_no")
  widthMm                   Int?     @map("width_mm")
  heightMm                  Int?     @map("height_mm")
  depthMm                   Int?     @map("depth_mm")
  quantity                  Float    @default(1)
  aiConfidence              Float?   @map("ai_confidence")
  /// very_high | high | medium | low
  aiConfidenceLevel         String?  @map("ai_confidence_level")
  aiDetectedType            String?  @map("ai_detected_type")
  isAiProduced              Boolean  @default(false) @map("is_ai_produced")
  isUserCorrected           Boolean  @default(false) @map("is_user_corrected")
  isManualRevision          Boolean  @default(false) @map("is_manual_revision")
  photoFileAssetId          String?  @map("photo_file_asset_id")
  annotatedPhotoFileAssetId String?  @map("annotated_photo_file_asset_id")
  overlayJson               Json?    @map("overlay_json")
  extensionJson             Json?    @map("extension_json")
  gpsLat                    Float?   @map("gps_lat")
  gpsLng                    Float?   @map("gps_lng")
  deviceInfoJson            Json?    @map("device_info_json")
  measuredAt                DateTime @map("measured_at")
  measuredByUserId          String   @map("measured_by_user_id")
  /// Genişletilebilir TEXT (enum değil)
  source                    String   @default("mobile_ar")
  note                      String?
  createdAt                 DateTime @default(now()) @map("created_at")

  claimFile               ClaimFile           @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  element                 SmartMeasureElement @relation(fields: [elementId], references: [id], onDelete: Cascade)
  measuredBy              User                @relation("SmartMeasureVersionMeasuredBy", fields: [measuredByUserId], references: [id])
  photoFileAsset          FileAsset?          @relation("SmartMeasurePhotoAsset", fields: [photoFileAssetId], references: [id], onDelete: SetNull)
  annotatedPhotoFileAsset FileAsset?          @relation("SmartMeasureAnnotatedPhotoAsset", fields: [annotatedPhotoFileAssetId], references: [id], onDelete: SetNull)

  @@unique([elementId, versionNo], map: "uq_smv_element_ver")
  @@index([claimFileId, measuredAt], map: "idx_smv_claim_measured")
  @@index([elementId, versionNo], map: "idx_smv_element_ver")
  @@index([measuredAt], map: "idx_smv_measured_at")
  @@index([measuredByUserId], map: "idx_smv_measured_by")
  @@index([source], map: "idx_smv_source")
  @@index([claimFileId, source], map: "idx_smv_claim_source")
  @@index([aiConfidenceLevel], map: "idx_smv_ai_level")
  @@index([photoFileAssetId], map: "idx_smv_photo_asset")
  @@map("smart_measure_versions")
}

// Smart Quantity Takeoff — S3 persist omurgası (BUILD MODE; production migrate deploy ayrı onay)
enum TakeoffRunStatus {
  draft
  active
  superseded
  archived
}

enum TakeoffLineItemStatus {
  active
  void
}

model TakeoffRule {
  id                   String  @id @default(uuid())
  code                 String  @unique
  name                 String
  structureElementType String  @map("structure_element_type")
  active               Boolean @default(true)
  decisionSpecJson     Json    @map("decision_spec_json")
  calculationBindJson  Json    @map("calculation_bind_json")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  versionMembers TakeoffRuleVersionMember[]
  lineItems      TakeoffLineItem[]

  @@index([structureElementType, active])
  @@map("takeoff_rules")
}

model TakeoffRuleVersion {
  id                  String   @id @default(uuid())
  versionTag          String   @unique @map("version_tag")
  librarySnapshotHash String   @map("library_snapshot_hash")
  effectiveFrom       DateTime @map("effective_from")
  createdByUserId     String   @map("created_by_user_id")
  createdAt           DateTime @default(now()) @map("created_at")
  notes               String?

  createdByUser User                       @relation("TakeoffRuleVersionCreatedBy", fields: [createdByUserId], references: [id])
  runs          TakeoffRun[]
  members       TakeoffRuleVersionMember[]

  @@map("takeoff_rule_versions")
}

model TakeoffRuleVersionMember {
  id            String @id @default(uuid())
  ruleVersionId String @map("rule_version_id")
  ruleId        String @map("rule_id")
  ruleBodyJson  Json   @map("rule_body_json")

  ruleVersion TakeoffRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Cascade)
  rule        TakeoffRule        @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleVersionId, ruleId])
  @@map("takeoff_rule_version_members")
}

model TakeoffRun {
  id                String           @id @default(uuid())
  claimFileId       String           @map("claim_file_id")
  ruleVersionId     String           @map("rule_version_id")
  runNumber         Int              @map("run_number")
  status            TakeoffRunStatus @default(active)
  note              String?
  createdByUserId   String           @map("created_by_user_id")
  createdAt         DateTime         @default(now()) @map("created_at")
  supersededByRunId String?          @map("superseded_by_run_id")

  claimFile       ClaimFile          @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  ruleVersion     TakeoffRuleVersion @relation(fields: [ruleVersionId], references: [id])
  createdByUser   User               @relation("TakeoffRunCreatedBy", fields: [createdByUserId], references: [id])
  supersededByRun TakeoffRun?        @relation("TakeoffRunSupersedes", fields: [supersededByRunId], references: [id], onDelete: SetNull)
  supersedesRuns  TakeoffRun[]       @relation("TakeoffRunSupersedes")
  lineItems       TakeoffLineItem[]

  @@unique([claimFileId, runNumber])
  @@index([claimFileId, status])
  @@map("takeoff_runs")
}

model TakeoffLineItem {
  id                     String                @id @default(uuid())
  takeoffRunId           String                @map("takeoff_run_id")
  operationItemCode      String                @map("operation_item_code")
  displayName            String                @map("display_name")
  structureElementType   String                @map("structure_element_type")
  sourceMeasureElementId String?               @map("source_measure_element_id")
  unit                   String
  quantityEngine         Decimal               @map("quantity_engine") @db.Decimal(18, 4)
  quantityFinal          Decimal               @map("quantity_final") @db.Decimal(18, 4)
  hasOverride            Boolean               @default(false) @map("has_override")
  ruleId                 String                @map("rule_id")
  ruleVersionId          String                @map("rule_version_id")
  metrajSnapshotJson     Json?                 @map("metraj_snapshot_json")
  sortOrder              Int                   @default(0) @map("sort_order")
  status                 TakeoffLineItemStatus @default(active)

  run         TakeoffRun                @relation(fields: [takeoffRunId], references: [id], onDelete: Cascade)
  rule        TakeoffRule               @relation(fields: [ruleId], references: [id])
  explanation TakeoffCalculationExplanation?
  overrides   TakeoffManualOverride[]
  sources     TakeoffLineItemSource[]

  @@index([takeoffRunId])
  @@map("takeoff_line_items")
}

model TakeoffLineItemSource {
  id                    String @id @default(uuid())
  takeoffLineItemId     String @map("takeoff_line_item_id")
  smartMeasureVersionId String @map("smart_measure_version_id")

  lineItem TakeoffLineItem @relation(fields: [takeoffLineItemId], references: [id], onDelete: Cascade)

  @@index([smartMeasureVersionId])
  @@map("takeoff_line_item_sources")
}

model TakeoffManualOverride {
  id                      String   @id @default(uuid())
  takeoffLineItemId       String   @map("takeoff_line_item_id")
  quantityEnginePreserved Decimal  @map("quantity_engine_preserved") @db.Decimal(18, 4)
  quantityOverride        Decimal  @map("quantity_override") @db.Decimal(18, 4)
  reason                  String
  createdByUserId         String   @map("created_by_user_id")
  createdAt               DateTime @default(now()) @map("created_at")
  active                  Boolean  @default(true)

  lineItem TakeoffLineItem @relation(fields: [takeoffLineItemId], references: [id], onDelete: Cascade)

  @@index([takeoffLineItemId, active])
  @@map("takeoff_manual_overrides")
}

model TakeoffCalculationExplanation {
  id                   String @id @default(uuid())
  takeoffLineItemId    String @unique @map("takeoff_line_item_id")
  measureSummary       String @map("measure_summary")
  ruleCode             String @map("rule_code")
  ruleVersionTag       String @map("rule_version_tag")
  decisionPathJson     Json   @map("decision_path_json")
  calculationStepsJson Json   @map("calculation_steps_json")
  overrideSummaryJson  Json?  @map("override_summary_json")
  humanReadableText    String @map("human_readable_text")

  lineItem TakeoffLineItem @relation(fields: [takeoffLineItemId], references: [id], onDelete: Cascade)

  @@map("takeoff_calculation_explanations")
}

// Operasyonel erişim izinleri (vekalet) — Faz 1
model OperationalAccessGrant {
  id               String    @id @default(uuid())
  granteeUserId    String    @map("grantee_user_id")
  principalUserId  String?   @map("principal_user_id")
  scopeType        String    @map("scope_type")
  // hasar | acil_yardim | both
  grantType        String    @map("grant_type")
  // person_delegation | function_delegation
  accessLevel      String    @default("manage") @map("access_level")
  // view | manage
  validFrom        DateTime  @map("valid_from")
  validTo          DateTime? @map("valid_to")
  reason           String?
  grantedByUserId  String    @map("granted_by_user_id")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  granteeUser   User  @relation("GranteeUser", fields: [granteeUserId], references: [id], onDelete: Cascade)
  principalUser User? @relation("PrincipalUser", fields: [principalUserId], references: [id], onDelete: SetNull)
  grantedByUser User  @relation("GrantedByUser", fields: [grantedByUserId], references: [id])

  @@index([granteeUserId, isActive])
  @@index([principalUserId])
  @@index([grantType, scopeType])
  @@map("operational_access_grants")
}
