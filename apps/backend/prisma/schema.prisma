  revisedAt           DateTime? @map("revised_at")
  revisedByUserId     String?  @map("revised_by_user_id")
  revisionCount       Int      @default(0) @map("revision_count")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  claimFile      ClaimFile          @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  createdBy      User               @relation("CreatedRepairReports", fields: [createdByUserId], references: [id])
  revisedBy      User?              @relation("RevisedRepairReports", fields: [revisedByUserId], references: [id])
  department     Department?        @relation(fields: [departmentId], references: [id])
  expertOffice   Customer?          @relation("ExpertOfficeReports", fields: [expertOfficeId], references: [id])
  originalReport RepairReport?      @relation("ReportVersions", fields: [originalReportId], references: [id])
