  slaViolation      Boolean @default(true) @map("sla_violation")
  revisionRequest   Boolean @default(true) @map("revision_request")
  managerInstruction Boolean @default(true) @map("manager_instruction")
  claimClosed       Boolean @default(true) @map("claim_closed")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_email_preferences")
}

// ─── SMS / WhatsApp Bildirim Altyapısı ───────────────────────────────────────

model SmsLog {
  id         String    @id @default(uuid())
  to         String
  message    String    @db.Text
  status     String    @default("queued") // queued | sent | failed
  provider   String    @default("console") // console | netgsm | iletimerkezi | twilio
  claimFileId String?  @map("claim_file_id")
  errorMsg   String?   @map("error_msg")
  sentAt     DateTime? @map("sent_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@index([createdAt])
  @@index([claimFileId])
  @@map("sms_logs")
}

model MessageTemplate {
  id        String   @id @default(uuid())
  type      String   @unique // sms_assignment | whatsapp_assignment
  name      String
  content   String   @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([type])
  @@map("message_templates")
}

// ─── KVKK / Sözleşme Elektronik Onay ─────────────────────────────────────────

model Agreement {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text  // HTML içerik
  type      String             // kvkk | gizlilik | is_sozlesmesi
  version   String   @default("1.0")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  acceptances AgreementAcceptance[]

  @@index([type])
  @@index([isActive])
  @@map("agreements")
}

model AgreementAcceptance {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  agreementId String   @map("agreement_id")
  acceptedAt  DateTime @default(now()) @map("accepted_at")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  signature   String?  // ad soyad yazarak imza

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@unique([userId, agreementId])
  @@index([userId])
  @@index([agreementId])
  @@map("agreement_acceptances")
}

// ─── Faz 3: Tedarikçi Ödeme Ekstre & Mutabakat Sistemi ───────────────────────

enum VendorStatementStatus {
  DRAFT
  SENT
  PARTIALLY_APPROVED
  APPROVED
  DISPUTED
  CLOSED

  @@map("vendor_statement_status")
}

enum VendorStatementItemApprovalStatus {
  PENDING
  APPROVED
  DISPUTED
  AUTO_APPROVED

  @@map("vendor_statement_item_approval_status")
}

enum VendorDisputeReason {
  AMOUNT_MISMATCH
  ITEM_NOT_DONE
  WRONG_CLAIM
  NOT_RECEIVED
  OTHER

  @@map("vendor_dispute_reason")
}

enum VendorDisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_ACCEPT
  RESOLVED_REJECT
  WITHDRAWN

  @@map("vendor_dispute_status")
}

enum VendorDisputeAlertType {
  HIGH_DISPUTE_RATE
  REPEATED_DISPUTE_SAME_ITEM
  BULK_DISPUTE

  @@map("vendor_dispute_alert_type")
}

model VendorPaymentStatement {
  id              String                  @id @default(uuid())
  vendorId        String                  @map("vendor_id")
  statementNo     String                  @unique @map("statement_no")
  periodStart     DateTime                @map("period_start")
  periodEnd       DateTime                @map("period_end")
  totalAmount     Float                   @default(0) @map("total_amount")
  currency        String                  @default("TRY")
  status          VendorStatementStatus   @default(DRAFT)
  sentAt          DateTime?               @map("sent_at")
  deadlineAt      DateTime?               @map("deadline_at")
  autoApprovedAt  DateTime?               @map("auto_approved_at")
  createdByUserId String                  @map("created_by_user_id")
  notes           String?
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  vendor       Vendor                    @relation(fields: [vendorId], references: [id])
  createdBy    User                      @relation("CreatedVendorStatements", fields: [createdByUserId], references: [id])
  items        VendorStatementItem[]
  receipts     VendorStatementReceipt[]
  tokens       VendorStatementToken[]
  disputeAlerts VendorDisputeAlert[]

  @@index([vendorId])
  @@index([status])
  @@index([deadlineAt])
  @@map("vendor_payment_statements")
}

model VendorStatementItem {
  id                  String                              @id @default(uuid())
  statementId         String                              @map("statement_id")
  paymentId           String?                             @map("payment_id")
  claimFileId         String                              @map("claim_file_id")
  repairReportItemId  String?                             @map("repair_report_item_id")
  workGroupId         String?                             @map("work_group_id")
  lineDescription     String                              @map("line_description")
  quantity            Float                               @default(1)
  unit                String?
  unitPrice           Float                               @map("unit_price")
  totalAmount         Float                               @map("total_amount")
  vatRate             Float                               @default(18) @map("vat_rate")
  receiptRef          String?                             @map("receipt_ref")
  receiptDate         DateTime?                           @map("receipt_date")
  approvalStatus      VendorStatementItemApprovalStatus   @default(PENDING)
  approvedAt          DateTime?                           @map("approved_at")
  disputedAt          DateTime?                           @map("disputed_at")
  sortOrder           Int                                 @default(0) @map("sort_order")
  createdAt           DateTime                            @default(now()) @map("created_at")
  updatedAt           DateTime                            @updatedAt @map("updated_at")

  statement        VendorPaymentStatement  @relation(fields: [statementId], references: [id], onDelete: Cascade)
  payment          Payment?                @relation(fields: [paymentId], references: [id])
  claimFile        ClaimFile               @relation(fields: [claimFileId], references: [id])
  repairReportItem RepairReportItem?       @relation(fields: [repairReportItemId], references: [id])
  workGroup        WorkGroup?              @relation(fields: [workGroupId], references: [id])
  disputeRecord    VendorStatementDispute?

  @@index([statementId])
  @@index([claimFileId])
  @@index([approvalStatus])
  @@map("vendor_statement_items")
}

model VendorStatementReceipt {
  id              String    @id @default(uuid())
  statementId     String    @map("statement_id")
  paymentId       String?   @map("payment_id")
  storageKey      String    @map("storage_key")
  fileName        String    @map("file_name")
  mimeType        String    @map("mime_type")
  fileSize        Int       @map("file_size")
  bankRef         String?   @map("bank_ref")
  bankDate        DateTime? @map("bank_date")
  amount          Float
  uploadedByUserId String   @map("uploaded_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  statement  VendorPaymentStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  payment    Payment?               @relation(fields: [paymentId], references: [id])
  uploadedBy User                   @relation("UploadedStatementReceipts", fields: [uploadedByUserId], references: [id])

  @@index([statementId])
  @@map("vendor_statement_receipts")
}

model VendorStatementDispute {
  id               String               @id @default(uuid())
  statementItemId  String               @unique @map("statement_item_id")
  vendorId         String               @map("vendor_id")
  reason           VendorDisputeReason
  reasonNote       String               @map("reason_note")
  evidenceStorageKey String?            @map("evidence_storage_key")
  evidenceFileName   String?            @map("evidence_file_name")
  status           VendorDisputeStatus  @default(OPEN)
  resolvedAt       DateTime?            @map("resolved_at")
  resolvedByUserId String?              @map("resolved_by_user_id")
  resolvedNote     String?              @map("resolved_note")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  statementItem   VendorStatementItem @relation(fields: [statementItemId], references: [id], onDelete: Cascade)
  vendor          Vendor              @relation(fields: [vendorId], references: [id])
  resolvedBy      User?               @relation("ResolvedVendorDisputes", fields: [resolvedByUserId], references: [id])

  @@index([vendorId])
  @@index([status])
  @@map("vendor_statement_disputes")
}

model VendorStatementToken {
  id          String    @id @default(uuid())
  statementId String    @map("statement_id")
  token       String    @unique
  expiresAt   DateTime  @map("expires_at")
  accessedAt  DateTime? @map("accessed_at")
  ipAddress   String?   @map("ip_address")
  createdAt   DateTime  @default(now()) @map("created_at")

  statement VendorPaymentStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([statementId])
  @@map("vendor_statement_tokens")
}

model VendorDisputeAlert {
  id                   String                  @id @default(uuid())
  vendorId             String                  @map("vendor_id")
  statementId          String?                 @map("statement_id")
  alertType            VendorDisputeAlertType
  disputeCount         Int                     @map("dispute_count")
  windowDays           Int                     @map("window_days")
  isAcknowledged       Boolean                 @default(false) @map("is_acknowledged")
  acknowledgedByUserId String?                 @map("acknowledged_by_user_id")
  acknowledgedAt       DateTime?               @map("acknowledged_at")
  createdAt            DateTime                @default(now()) @map("created_at")

  vendor              Vendor                  @relation(fields: [vendorId], references: [id])
  statement           VendorPaymentStatement? @relation(fields: [statementId], references: [id])
  acknowledgedBy      User?                   @relation("AcknowledgedVendorAlerts", fields: [acknowledgedByUserId], references: [id])

  @@index([vendorId])
  @@index([isAcknowledged])
  @@map("vendor_dispute_alerts")
}

// ─── Tedarikçi Risk Yönetimi & Maliyet Analiz Sistemi ────────────────────────

model VendorRiskScore {
  id                      String   @id @default(uuid())
  vendorId                String   @unique @map("vendor_id")
  disputeRateScore        Float    @default(0) @map("dispute_rate_score")
  revisionFreqScore       Float    @default(0) @map("revision_freq_score")
  priceDeviationScore     Float    @default(0) @map("price_deviation_score")
  deliveryComplianceScore Float    @default(0) @map("delivery_compliance_score")
  concentrationScore      Float    @default(0) @map("concentration_score")
  totalScore              Float    @default(0) @map("total_score")
  riskLevel               String   @default("low") @map("risk_level")
  calculatedAt            DateTime @default(now()) @map("calculated_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([riskLevel])
  @@index([totalScore])
  @@map("vendor_risk_scores")
}

model VendorRiskScoreHistory {
  id           String   @id @default(uuid())
  vendorId     String   @map("vendor_id")
  totalScore   Float    @map("total_score")
  riskLevel    String   @map("risk_level")
  snapshot     Json
  calculatedAt DateTime @default(now()) @map("calculated_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, calculatedAt])
  @@map("vendor_risk_score_history")
}

model MarketPriceCatalog {
  id             String   @id @default(uuid())
  workGroupId    String   @map("work_group_id")
  jobDescription String   @map("job_description")
  unit           String   @default("adet")
  regionType     String   @default("national") @map("region_type")
  minPrice       Float    @map("min_price")
  maxPrice       Float    @map("max_price")
  referencePrice Float    @map("reference_price")
  tolerancePct   Float    @default(15) @map("tolerance_pct")
  source         String   @default("internal")
  validFrom      DateTime @map("valid_from")
  validTo        DateTime? @map("valid_to")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  workGroup    WorkGroup              @relation(fields: [workGroupId], references: [id])
  anomalyFlags RepairItemAnomalyFlag[]

  @@index([workGroupId, regionType])
  @@index([isActive])
  @@map("market_price_catalog")
}

model RepairItemAnomalyFlag {
  id                 String    @id @default(uuid())
  repairReportItemId String    @map("repair_report_item_id")
  reportId           String    @map("report_id")
  vendorId           String?   @map("vendor_id")
  catalogId          String?   @map("catalog_id")
  flagType           String    @map("flag_type")
  deviationPct       Float?    @map("deviation_pct")
  supplierPrice      Float?    @map("supplier_price")
  referencePrice     Float?    @map("reference_price")
  severity           String    @default("warning")
  status             String    @default("open")
  reviewedByUserId   String?   @map("reviewed_by_user_id")
  reviewedAt         DateTime? @map("reviewed_at")
  reviewNote         String?   @map("review_note")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  repairReportItem RepairReportItem    @relation(fields: [repairReportItemId], references: [id], onDelete: Cascade)
  catalog          MarketPriceCatalog? @relation(fields: [catalogId], references: [id])

  @@index([reportId])
  @@index([vendorId])
  @@index([status])
  @@index([flagType])
  @@map("repair_item_anomaly_flags")
}

model VendorConcentrationSnapshot {
  id               String   @id @default(uuid())
  vendorId         String   @map("vendor_id")
  workGroupId      String   @map("work_group_id")
  periodStart      DateTime @map("period_start")
  periodEnd        DateTime @map("period_end")
  vendorJobCount   Int      @map("vendor_job_count")
  totalJobCount    Int      @map("total_job_count")
  vendorAmount     Float    @map("vendor_amount")
  totalAmount      Float    @map("total_amount")
  concentrationPct Float    @map("concentration_pct")
  isOverThreshold  Boolean  @default(false) @map("is_over_threshold")
  thresholdPct     Float    @default(60) @map("threshold_pct")
  createdAt        DateTime @default(now()) @map("created_at")

  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  workGroup WorkGroup @relation(fields: [workGroupId], references: [id], onDelete: Cascade)

  @@index([vendorId, workGroupId])
  @@index([periodStart])
  @@index([isOverThreshold])
  @@map("vendor_concentration_snapshots")
}

// ─── Faz 3: P&L Modülü ───────────────────────────────────────────────────────

model ExtraWorkItem {
  id              String    @id @default(uuid())
  claimFileId     String    @map("claim_file_id")
  title           String
  description     String?
  status          String    @default("draft")
  // draft | approved | completed | cancelled
  agreedAt        DateTime? @map("agreed_at")
  completedAt     DateTime? @map("completed_at")
  createdByUserId String    @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  claimFile   ClaimFile          @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  createdBy   User               @relation("CreatedExtraWorkItems", fields: [createdByUserId], references: [id])
  revenues    ClaimFileRevenue[]
  costEntries CostEntry[]

  @@index([claimFileId])
  @@index([status])
  @@map("extra_work_items")
}

model ClaimFileRevenue {
  id               String    @id @default(uuid())
  claimFileId      String    @map("claim_file_id")
  revenueType      String    @map("revenue_type")
  // file_fee | extra_work
  collectionSource String    @map("collection_source")
  // insurance_company | insured
  description      String?
  amount           Float
  vatRate          Float     @default(0) @map("vat_rate")
  vatAmount        Float     @default(0) @map("vat_amount")
  totalAmount      Float     @map("total_amount")
  invoiceId        String?   @map("invoice_id")
  repairReportId   String?   @map("repair_report_id")
  extraWorkItemId  String?   @map("extra_work_item_id")
  // revenueType='extra_work' ise zorunlu; 'file_fee' ise null
  status           String    @default("confirmed")
  // draft | confirmed | collected | cancelled
  collectedAmount  Float     @default(0) @map("collected_amount")
  collectedAt      DateTime? @map("collected_at")
  relatedPaymentId String?   @map("related_payment_id")
  currency         String    @default("TRY")
  entryDate        DateTime  @map("entry_date")
  createdByUserId  String    @map("created_by_user_id")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  claimFile      ClaimFile     @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id])
  repairReport   RepairReport? @relation(fields: [repairReportId], references: [id])
  extraWorkItem  ExtraWorkItem? @relation(fields: [extraWorkItemId], references: [id])
  relatedPayment Payment?      @relation("RevenuePayment", fields: [relatedPaymentId], references: [id])
  createdBy      User          @relation("CreatedFileRevenues", fields: [createdByUserId], references: [id])

  @@index([claimFileId])
  @@index([revenueType])
  @@index([collectionSource])
  @@index([status])
  @@map("claim_file_revenues")
}

model MonthlyOverheadEntry {
  id                String    @id @default(uuid())
  year              Int
  month             Int       // 1–12
  expenseCategoryId String    @map("expense_category_id")
  amount            Float
  currency          String    @default("TRY")
  description       String?
  source            String    @default("manual")
  // manual | logo_erp
  logoEntryRef      String?   @map("logo_entry_ref")
  isAllocated       Boolean   @default(false) @map("is_allocated")
  allocatedAt       DateTime? @map("allocated_at")
  createdByUserId   String    @map("created_by_user_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  expenseCategory ExpenseCategory      @relation(fields: [expenseCategoryId], references: [id])
  createdBy       User                 @relation("CreatedOverheadEntries", fields: [createdByUserId], references: [id])
  allocations     OverheadAllocation[]

  @@unique([year, month, expenseCategoryId])
  @@index([year, month])
  @@map("monthly_overhead_entries")
}

model OverheadAllocation {
  id               String   @id @default(uuid())
  overheadEntryId  String   @map("overhead_entry_id")
  claimFileId      String   @map("claim_file_id")
  allocationMethod String   @map("allocation_method")
  // equal | proportional_revenue | hybrid
  allocationWeight Float    @map("allocation_weight")
  // 0–1, bu dosyanın toplam portföydeki ağırlığı
  allocatedAmount  Float    @map("allocated_amount")
  costEntryId      String?  @unique @map("cost_entry_id")
  // CostEntry (isOverhead=true) kaydının ID'si
  createdAt        DateTime @default(now()) @map("created_at")

  overheadEntry MonthlyOverheadEntry @relation(fields: [overheadEntryId], references: [id], onDelete: Cascade)
  claimFile     ClaimFile            @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  costEntry     CostEntry?           @relation(fields: [costEntryId], references: [id])

  @@index([overheadEntryId])
  @@index([claimFileId])
  @@map("overhead_allocations")
}

// ─── Rapor Şablonları ──────────────────────────────────────────────────────────

model ReportTemplate {
  id          String   @id @default(uuid())
  name        String
  serviceType String   @map("service_type")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items ReportTemplateItem[]

  @@index([serviceType])
  @@map("report_templates")
}

model ReportTemplateItem {
  id              String   @id @default(uuid())
  templateId      String   @map("template_id")
  workGroupId     String?  @map("work_group_id")
  damageCategory  String   @default("bina") @map("damage_category")
  location        String?
  jobDescription  String   @map("job_description")
  description     String?
  defaultQuantity Float    @default(1) @map("default_quantity")
  defaultUnit     String   @default("adet") @map("default_unit")
  pricingType     String   @default("unit") @map("pricing_type")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  template  ReportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
