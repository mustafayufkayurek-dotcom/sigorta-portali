  @@index([insuranceCompanyId])
  @@index([claimFileId])
  @@map("survey_campaigns")
}

model SurveyResponse {
  id           String   @id @default(uuid())
  campaignId   String   @unique @map("campaign_id")
  q1Rating     Int      @map("q1_rating")
  q2Rating     Int      @map("q2_rating")
  q3Rating     Int      @map("q3_rating")
  q4Rating     Int      @map("q4_rating")
  q5Rating     Int      @map("q5_rating")
  q6Recommend  Boolean  @map("q6_recommend")
  q7Comment    String?  @map("q7_comment")
  submittedAt  DateTime @default(now()) @map("submitted_at")
  ipAddress    String?  @map("ip_address")

  campaign SurveyCampaign @relation(fields: [campaignId], references: [id])

  @@map("survey_responses")
}

// ─── Ekran İzin Sistemi ───────────────────────────────────────────────────────

model ScreenPermission {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  screenCode String   @map("screen_code")
  canView    Boolean  @default(true) @map("can_view")
  canEdit    Boolean  @default(false) @map("can_edit")
  createdAt  DateTime @default(now()) @map("created_at")
