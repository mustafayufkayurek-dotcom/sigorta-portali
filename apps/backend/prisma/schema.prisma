// ─── Acil Yardım Operasyon Modülü ────────────────────────────────────────────

enum EmergencyStatus {
  GELEN
  ATANDI
  SAHADA
  COZULDU
  FATURALANDILDI

  @@map("emergency_status")
}

enum EmergencyUrgency {
  DUSUK
  NORMAL
  YUKSEK
  KRITIK

  @@map("emergency_urgency")
}

model EmergencyCase {
  id               String           @id @default(uuid())
  caseNo           String           @unique @map("case_no")
  fileNo           String?          @map("file_no")
  customerId       String?          @map("customer_id")
  customerName     String           @map("customer_name")
  customerPhone    String?          @map("customer_phone")
  address          String
  city             String?
  district         String?
  issueType        String           @map("issue_type")
  urgency          EmergencyUrgency @default(NORMAL)
  status           EmergencyStatus  @default(GELEN)
  assignedVendorId String?          @map("assigned_vendor_id")
  assignedUserId   String?          @map("assigned_user_id")
  notes            String?
  resolvedAt       DateTime?        @map("resolved_at")
  invoicedAt       DateTime?        @map("invoiced_at")
  createdByUserId  String           @map("created_by_user_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  customer       Customer?  @relation("EmergencyCustomer", fields: [customerId], references: [id])
  assignedVendor Vendor?    @relation("EmergencyVendor", fields: [assignedVendorId], references: [id])
  assignedUser   User?      @relation("EmergencyAssignedUser", fields: [assignedUserId], references: [id])
  createdBy      User       @relation("EmergencyCreatedBy", fields: [createdByUserId], references: [id])
  costEntries    EmergencyCostEntry[]
  invoiceItems   EmergencyInvoiceItem[]
  // Dosya Evrak & Fatura Talebi
  fileDocuments  FileDocument[]
  invoiceRequests InvoiceRequest[]

  @@index([status])
  @@index([urgency])
  @@index([createdAt])
  @@map("emergency_cases")
}

model EmergencyCostEntry {
  id              String    @id @default(uuid())
  caseId          String    @map("case_id")
  vendorId        String?   @map("vendor_id")
  entryType       String    @map("entry_type")
  description     String
  amount          Float
  receiptKey      String?   @map("receipt_key")
  entryDate       DateTime  @map("entry_date")
  createdByUserId String    @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  case      EmergencyCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  vendor    Vendor?       @relation("EmergencyCostVendor", fields: [vendorId], references: [id], onDelete: SetNull)
  createdBy User          @relation("EmergencyCostCreatedBy", fields: [createdByUserId], references: [id])

  @@index([caseId])
  @@index([entryType])
  @@index([vendorId])
  @@map("emergency_cost_entries")
}

model EmergencyInvoiceDraft {
  id              String    @id @default(uuid())
  draftNo         String    @unique @map("draft_no")
  customerId      String?   @map("customer_id")
  customerName    String    @map("customer_name")
  totalAmount     Float     @default(0) @map("total_amount")
  status          String    @default("draft")
  logoRef         String?   @map("logo_ref")
  notes           String?
  createdByUserId String    @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  createdBy User                   @relation("EmergencyInvoiceCreatedBy", fields: [createdByUserId], references: [id])
  items     EmergencyInvoiceItem[]

  @@index([status])
  @@map("emergency_invoice_drafts")
}

model EmergencyInvoiceItem {
  id          String    @id @default(uuid())
  draftId     String    @map("draft_id")
  caseId      String    @map("case_id")
  amount      Float
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")

  draft EmergencyInvoiceDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  case  EmergencyCase         @relation(fields: [caseId], references: [id])

  @@index([draftId])
  @@index([caseId])
  @@map("emergency_invoice_items")
}

// ─── Tedarikçi Sözleşme Sistemi ──────────────────────────────────────────────

model VendorContractTemplate {
  id        String   @id @default(uuid())
  name      String   @default("Tedarikçi Onarım Sözleşmesi")
  isActive  Boolean  @default(true) @map("is_active")
  version   String   @default("1.0")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clauses   VendorContractClause[]
  contracts VendorContract[]

  @@map("vendor_contract_templates")
}

model VendorContractClause {
  id         String   @id @default(uuid())
  templateId String   @map("template_id")
  title      String
  content    String   @db.Text
  sortOrder  Int      @default(0) @map("sort_order")
  isRequired Boolean  @default(true) @map("is_required")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  template VendorContractTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, sortOrder])
  @@map("vendor_contract_clauses")
}

model VendorContract {
  id                   String    @id @default(uuid())
  contractNo           String    @unique @map("contract_no")
  claimFileId          String    @map("claim_file_id")
  vendorId             String    @map("vendor_id")
  repairReportId       String?   @map("repair_report_id")
  templateId           String    @map("template_id")
  contractDate         DateTime  @map("contract_date")
  startDate            DateTime? @map("start_date")
  deliveryDate         DateTime? @map("delivery_date")
  vendorName           String    @map("vendor_name")
  vendorTaxOrIdNo      String?   @map("vendor_tax_or_id_no")
  vendorAddress        String?   @map("vendor_address")
  vendorPhone          String?   @map("vendor_phone")
  insuredName          String?   @map("insured_name")
  fileNo               String    @map("file_no")
  insuranceCompanyName String?   @map("insurance_company_name")
  damageAddress        String?   @map("damage_address")
  workItems            Json      @default("[]") @map("work_items")
  renderedContent      String    @db.Text @map("rendered_content")
  status               String    @default("draft")
  signedAt             DateTime? @map("signed_at")
  vendorSignatureData  String?   @map("vendor_signature_data")
  whatsappSentAt       DateTime? @map("whatsapp_sent_at")
  whatsappPhone        String?   @map("whatsapp_phone")
  reminderCount        Int       @default(0) @map("reminder_count")
  lastReminderAt       DateTime? @map("last_reminder_at")
  signDeadlineAt       DateTime? @map("sign_deadline_at")
  createdByUserId      String    @map("created_by_user_id")
  pdfStorageKey        String?   @map("pdf_storage_key")
  publicToken          String?   @unique @map("public_token")
  publicTokenExpiresAt DateTime? @map("public_token_expires_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  claimFile    ClaimFile              @relation(fields: [claimFileId], references: [id])
  vendor       Vendor                 @relation(fields: [vendorId], references: [id])
  repairReport RepairReport?          @relation(fields: [repairReportId], references: [id])
  template     VendorContractTemplate @relation(fields: [templateId], references: [id])
  createdBy    User                   @relation("CreatedVendorContracts", fields: [createdByUserId], references: [id])

  @@index([claimFileId])
  @@index([vendorId])
  @@index([status])
  @@index([publicToken])
  @@map("vendor_contracts")
}

// ─── Dosya Evrak Sistemi (Muvafakatname / Matbu Evrak) ────────────────────────

model FileDocument {
  id                       String    @id @default(uuid())
  entityType               String    @map("entity_type")    // claim_file | emergency_case
  entityId                 String    @map("entity_id")
  documentKind             String    @map("document_kind")  // muvafakatname | matbu_evrak
  status                   String    @default("draft")
  // draft | sent | viewed | digitally_approved | physically_uploaded

  renderedContent          String    @db.Text @map("rendered_content")

  // Dijital onay
  publicToken              String?   @unique @map("public_token")
  publicTokenExpiresAt     DateTime? @map("public_token_expires_at")
  whatsappSentAt           DateTime? @map("whatsapp_sent_at")
  whatsappPhone            String?   @map("whatsapp_phone")
  viewedAt                 DateTime? @map("viewed_at")
  viewedIp                 String?   @map("viewed_ip")
  digitallyApprovedAt      DateTime? @map("digitally_approved_at")
  approvedIp               String?   @map("approved_ip")
  approvedFullName         String?   @map("approved_full_name")
  signatureData            String?   @map("signature_data")

  // Fiziki yükleme (yalnızca hasar/muvafakatname için zorunlu)
  physicalUploadKey        String?   @map("physical_upload_key")
  physicalUploadedAt       DateTime? @map("physically_uploaded_at")
  physicalUploadedByUserId String?   @map("physical_uploaded_by_user_id")

  // Polymorphic relations
  claimFileId              String?   @map("claim_file_id")
  emergencyCaseId          String?   @map("emergency_case_id")

  createdByUserId          String    @map("created_by_user_id")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  claimFile           ClaimFile?    @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  emergencyCase       EmergencyCase? @relation(fields: [emergencyCaseId], references: [id], onDelete: Cascade)
  createdBy           User          @relation("CreatedFileDocuments", fields: [createdByUserId], references: [id])
  physicalUploadedBy  User?         @relation("PhysicalUploadedBy", fields: [physicalUploadedByUserId], references: [id])

  @@index([entityType, entityId])
  @@index([publicToken])
  @@index([status])
  @@index([claimFileId])
  @@index([emergencyCaseId])
  @@map("file_documents")
}

// ─── Fatura Talebi Sistemi ─────────────────────────────────────────────────────

model InvoiceRequest {
  id                   String    @id @default(uuid())
  requestNo            String    @unique @map("request_no")       // FT-2026-00001
  serviceType          String    @map("service_type")             // claim | emergency

  claimFileId          String?   @map("claim_file_id")
  emergencyCaseId      String?   @map("emergency_case_id")

  insuranceCompanyId   String?   @map("insurance_company_id")
  insuranceCompanyName String?   @map("insurance_company_name")   // denormalized
  fileNo               String    @map("file_no")

  totalAmount          Float     @default(0) @map("total_amount")
  workItemsSummary     Json      @default("[]") @map("work_items_summary")
  // [{ description: string, amount: number, vatRate: number }]

  status               String    @default("pending")
  // pending | approved | invoiced | cancelled

  invoiceId            String?   @map("invoice_id")

  notes                String?
  createdByUserId      String    @map("created_by_user_id")
  approvedByUserId     String?   @map("approved_by_user_id")
  approvedAt           DateTime? @map("approved_at")
  invoicedAt           DateTime? @map("invoiced_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  claimFile          ClaimFile?        @relation(fields: [claimFileId], references: [id])
  emergencyCase      EmergencyCase?    @relation(fields: [emergencyCaseId], references: [id])
  insuranceCompany   InsuranceCompany? @relation(fields: [insuranceCompanyId], references: [id])
  createdBy          User              @relation("CreatedInvoiceRequests", fields: [createdByUserId], references: [id])
  approvedBy         User?             @relation("ApprovedInvoiceRequests", fields: [approvedByUserId], references: [id])
  invoice            Invoice?          @relation(fields: [invoiceId], references: [id])
  surveyCampaign     SurveyCampaign?

  @@index([status])
  @@index([claimFileId])
  @@index([emergencyCaseId])
  @@index([serviceType])
  @@map("invoice_requests")
}

// ─── Müşteri Memnuniyet Anket Sistemi ─────────────────────────────────────────

model SurveyCampaign {
  id                   String    @id @default(uuid())
  claimFileId          String?   @map("claim_file_id")
  emergencyCaseId      String?   @map("emergency_case_id")
  invoiceRequestId     String?   @unique @map("invoice_request_id")
  insuranceCompanyId   String?   @map("insurance_company_id")
  insuredName          String?   @map("insured_name")
  insuredPhone         String?   @map("insured_phone")
  publicToken          String    @unique @map("public_token")
  tokenExpiresAt       DateTime? @map("token_expires_at")
  whatsappSentAt       DateTime? @map("whatsapp_sent_at")
  whatsappDeepLink     String?   @map("whatsapp_deep_link")
  status               String    @default("pending")
  // pending | sent | completed | expired
  completedAt          DateTime? @map("completed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  claimFile        ClaimFile?        @relation(fields: [claimFileId], references: [id])
  insuranceCompany InsuranceCompany? @relation(fields: [insuranceCompanyId], references: [id])
  invoiceRequest   InvoiceRequest?   @relation(fields: [invoiceRequestId], references: [id])
  response         SurveyResponse?

  @@index([status])
  @@index([insuranceCompanyId])
  @@index([claimFileId])
  @@map("survey_campaigns")
}

model SurveyResponse {
  id           String   @id @default(uuid())
  campaignId   String   @unique @map("campaign_id")
  q1Rating     Int      @map("q1_rating")
  q2Rating     Int      @map("q2_rating")
  q3Rating     Int      @map("q3_rating")
  q4Rating     Int      @map("q4_rating")
  q5Rating     Int      @map("q5_rating")
  q6Recommend  Boolean  @map("q6_recommend")
  q7Comment    String?  @map("q7_comment")
  submittedAt  DateTime @default(now()) @map("submitted_at")
  ipAddress    String?  @map("ip_address")

  campaign SurveyCampaign @relation(fields: [campaignId], references: [id])

  @@map("survey_responses")
}

// ─── Ekran İzin Sistemi ───────────────────────────────────────────────────────

model ScreenPermission {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  screenCode String   @map("screen_code")
  canView    Boolean  @default(true) @map("can_view")
  canEdit    Boolean  @default(false) @map("can_edit")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, screenCode])
  @@index([userId])
  @@map("screen_permissions")
}

// ─── Masraf İzleme Sistemi ────────────────────────────────────────────────────

enum ExpenseGroup {
  YONETIM_GIDERLERI
  OPERASYON_GIDERLERI
  MHY_OZEL_GIDERLER
}

enum ExpensePlan {
  BUTCELENEN
  EKSTRA_SATIS_MASRAFI
}

enum ExpenseApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExpenseOperationSubject {
  HASAR_ONARIM
  ACIL_YARDIM
  OZEL_OPERASYON
  DANISMANLIK
  TEKNE_YAT
}

model Expense {
  id                String                  @id @default(uuid())
  date              DateTime
  amount            Decimal                 @db.Decimal(12, 2)
  vatRate           Int                     @default(20) @map("vat_rate")
  vatIncluded       Boolean                 @default(true) @map("vat_included")
  description       String?
  expenseGroup      ExpenseGroup            @map("expense_group")
  expenseSubgroup   String                  @map("expense_subgroup")
  expensePlan       ExpensePlan?            @map("expense_plan")
  approvalStatus    ExpenseApprovalStatus   @default(PENDING) @map("approval_status")
  approvedById      String?                 @map("approved_by_id")
  approvedAt        DateTime?               @map("approved_at")
  operationSubject  ExpenseOperationSubject? @map("operation_subject")
  fileCaseId        String?                 @map("file_case_id")
  receiptImageUrl   String?                 @map("receipt_image_url")
  createdById       String                  @map("created_by_id")
  weekNumber        Int?                    @map("week_number")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  approvedBy  User?      @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  createdBy   User       @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  fileCase    ClaimFile? @relation(fields: [fileCaseId], references: [id])

  @@index([expenseGroup])
  @@index([approvalStatus])
  @@index([date])
  @@index([createdById])
  @@map("expenses")
}

// ─── Fiyat Listesi & Bölgesel Zam Sistemi ─────────────────────────────────────

model Region {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  adjustments RegionalPriceAdjustment[]

  @@map("regions")
}

model RegionalPriceAdjustment {
  id                String   @id @default(uuid())
  regionId          String   @map("region_id")
  adjustmentPercent Decimal  @map("adjustment_percent") @db.Decimal(5, 2)
  effectiveDate     DateTime @map("effective_date")
  notes             String?
  createdByUserId   String?  @map("created_by_user_id")
  createdAt         DateTime @default(now()) @map("created_at")

  region Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@index([regionId, effectiveDate])
  @@map("regional_price_adjustments")
}

model PriceListVersion {
  id            String   @id @default(uuid())
  versionName   String
  effectiveDate DateTime @map("effective_date")
  isActive      Boolean  @default(false) @map("is_active")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("price_list_versions")
}

// ─── Ofis-Saha İş Akışı ──────────────────────────────────────────────────────

enum FileActivityAction {
  SUPPLIER_ASSIGNED
  APPOINTMENT_SCHEDULED
  APPOINTMENT_UPDATED
  INSPECTION_DONE
  COST_REPORT_SUBMITTED
  ATTACHMENT_ADDED
  STATUS_CHANGED
  NOTE_ADDED

  @@map("file_activity_action")
}

enum AttachmentVisibility {
  PUBLIC
  INTERNAL_ONLY

  @@map("attachment_visibility")
}

model FileActivityLog {
  id          String             @id @default(uuid())
  claimFileId String             @map("claim_file_id")
  action      FileActivityAction
  actorId     String             @map("actor_id")
  actorRole   String             @map("actor_role")
  description String
  metadata    Json?
  createdAt   DateTime           @default(now()) @map("created_at")

  claimFile ClaimFile @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  actor     User      @relation("FileActivityActor", fields: [actorId], references: [id])

  @@index([claimFileId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("file_activity_logs")
}

model FileAppointment {
  id               String    @id @default(uuid())
  claimFileId      String    @map("claim_file_id")
  scheduledDate    DateTime  @map("scheduled_date")
  notes            String?
  status           String    @default("planned")
  createdByUserId  String    @map("created_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  claimFile   ClaimFile @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("FileAppointmentCreatedBy", fields: [createdByUserId], references: [id])

  @@index([claimFileId])
  @@index([scheduledDate])
  @@map("file_appointments")
}

model ServiceType {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("service_types")
}

model UploadLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  fileName  String   @map("file_name")
  mimeType  String?  @map("mime_type")
  size      Int?
  endpoint  String?
  status    String   // SUCCESS | REJECTED
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("upload_logs")
}
