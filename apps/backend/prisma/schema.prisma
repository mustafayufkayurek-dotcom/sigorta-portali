  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  repairReportItem RepairReportItem    @relation(fields: [repairReportItemId], references: [id], onDelete: Cascade)
  catalog          MarketPriceCatalog? @relation(fields: [catalogId], references: [id])

  @@index([reportId])
  @@index([vendorId])
  @@index([status])
  @@index([flagType])
  @@map("repair_item_anomaly_flags")
}

model VendorConcentrationSnapshot {
  id               String   @id @default(uuid())
  vendorId         String   @map("vendor_id")
  workGroupId      String   @map("work_group_id")
  periodStart      DateTime @map("period_start")
  periodEnd        DateTime @map("period_end")
  vendorJobCount   Int      @map("vendor_job_count")
  totalJobCount    Int      @map("total_job_count")
  vendorAmount     Float    @map("vendor_amount")
  totalAmount      Float    @map("total_amount")
  concentrationPct Float    @map("concentration_pct")
  isOverThreshold  Boolean  @default(false) @map("is_over_threshold")
  thresholdPct     Float    @default(60) @map("threshold_pct")
  createdAt        DateTime @default(now()) @map("created_at")

  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  workGroup WorkGroup @relation(fields: [workGroupId], references: [id], onDelete: Cascade)

  @@index([vendorId, workGroupId])
  @@index([periodStart])
  @@index([isOverThreshold])
  @@map("vendor_concentration_snapshots")
}

// ─── Faz 3: P&L Modülü ───────────────────────────────────────────────────────

model ExtraWorkItem {
  id              String    @id @default(uuid())
  claimFileId     String    @map("claim_file_id")
  title           String
  description     String?
  status          String    @default("draft")
  // draft | approved | completed | cancelled
  agreedAt        DateTime? @map("agreed_at")
  completedAt     DateTime? @map("completed_at")
  createdByUserId String    @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  claimFile   ClaimFile          @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  createdBy   User               @relation("CreatedExtraWorkItems", fields: [createdByUserId], references: [id])
  revenues    ClaimFileRevenue[]
  costEntries CostEntry[]

  @@index([claimFileId])
  @@index([status])
  @@map("extra_work_items")
}

model ClaimFileRevenue {
  id               String    @id @default(uuid())
  claimFileId      String    @map("claim_file_id")
  revenueType      String    @map("revenue_type")
  // file_fee | extra_work
  collectionSource String    @map("collection_source")
  // insurance_company | insured
  description      String?
  amount           Float
  vatRate          Float     @default(0) @map("vat_rate")
  vatAmount        Float     @default(0) @map("vat_amount")
  totalAmount      Float     @map("total_amount")
  invoiceId        String?   @map("invoice_id")
  repairReportId   String?   @map("repair_report_id")
  extraWorkItemId  String?   @map("extra_work_item_id")
  // revenueType='extra_work' ise zorunlu; 'file_fee' ise null
  status           String    @default("confirmed")
  // draft | confirmed | collected | cancelled
  collectedAmount  Float     @default(0) @map("collected_amount")
  collectedAt      DateTime? @map("collected_at")
  relatedPaymentId String?   @map("related_payment_id")
  currency         String    @default("TRY")
  entryDate        DateTime  @map("entry_date")
  createdByUserId  String    @map("created_by_user_id")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  claimFile      ClaimFile     @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id])
  repairReport   RepairReport? @relation(fields: [repairReportId], references: [id])
  extraWorkItem  ExtraWorkItem? @relation(fields: [extraWorkItemId], references: [id])
  relatedPayment Payment?      @relation("RevenuePayment", fields: [relatedPaymentId], references: [id])
  createdBy      User          @relation("CreatedFileRevenues", fields: [createdByUserId], references: [id])
  collectionLinks PaymentCollectionLink[]

  @@index([claimFileId])
  @@index([revenueType])
  @@index([collectionSource])
  @@index([status])
  @@map("claim_file_revenues")
}

model PaymentCollectionLink {
  id              String    @id @default(uuid())
  claimFileId     String    @map("claim_file_id")
  revenueId       String?   @map("revenue_id")
  merchantOid     String    @unique @map("merchant_oid")
  amount          Float
  currency        String    @default("TRY")
  publicToken     String    @unique @map("public_token")
  tokenExpiresAt  DateTime  @map("token_expires_at")
  status          String    @default("draft")
  // draft | sent | opened | processing | paid | expired | cancelled | failed
  payerName       String?   @map("payer_name")
  payerPhone      String?   @map("payer_phone")
  payerEmail      String?   @map("payer_email")
  description     String?
  sentAt          DateTime? @map("sent_at")
  paidAt          DateTime? @map("paid_at")
  paymentId       String?   @map("payment_id")
  provider        String    @default("paytr")
  providerRef     String?   @map("provider_ref")
  providerPayload Json?     @map("provider_payload")
  failReason      String?   @map("fail_reason")
  createdByUserId String    @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  claimFile  ClaimFile          @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  revenue    ClaimFileRevenue?  @relation(fields: [revenueId], references: [id])
  payment    Payment?
  createdBy  User               @relation("CreatedCollectionLinks", fields: [createdByUserId], references: [id])

  @@index([claimFileId])
  @@index([status])
  @@index([tokenExpiresAt])
  @@map("payment_collection_links")
}

model MonthlyOverheadEntry {
  id                String    @id @default(uuid())
  year              Int
  month             Int       // 1–12
  expenseCategoryId String    @map("expense_category_id")
  amount            Float
  vatRate           Int       @default(20) @map("vat_rate")
  grossAmount       Float?    @map("gross_amount")
  currency          String    @default("TRY")
  description       String?
  source            String    @default("manual")
  // manual | logo_erp
  logoEntryRef      String?   @map("logo_entry_ref")
  isAllocated       Boolean   @default(false) @map("is_allocated")
  allocatedAt       DateTime? @map("allocated_at")
  createdByUserId   String    @map("created_by_user_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  expenseCategory ExpenseCategory      @relation(fields: [expenseCategoryId], references: [id])
  createdBy       User                 @relation("CreatedOverheadEntries", fields: [createdByUserId], references: [id])
  allocations     OverheadAllocation[]

  @@unique([year, month, expenseCategoryId])
  @@index([year, month])
  @@map("monthly_overhead_entries")
}

model OverheadAllocation {
  id                   String   @id @default(uuid())
  overheadEntryId      String   @map("overhead_entry_id")
  claimFileId          String?  @map("claim_file_id")
  emergencyCaseId      String?  @map("emergency_case_id")
  allocationMethod     String   @map("allocation_method")
  // equal | proportional_revenue | hybrid
  allocationWeight     Float    @map("allocation_weight")
  // 0–1, bu dosyanın toplam portföydeki ağırlığı
  allocatedAmount      Float    @map("allocated_amount")
  costEntryId          String?  @unique @map("cost_entry_id")
  emergencyCostEntryId String?  @unique @map("emergency_cost_entry_id")
  createdAt            DateTime @default(now()) @map("created_at")

  overheadEntry      MonthlyOverheadEntry @relation(fields: [overheadEntryId], references: [id], onDelete: Cascade)
  claimFile          ClaimFile?           @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  emergencyCase      EmergencyCase?       @relation(fields: [emergencyCaseId], references: [id], onDelete: Cascade)
  costEntry          CostEntry?           @relation(fields: [costEntryId], references: [id])
  emergencyCostEntry EmergencyCostEntry?  @relation(fields: [emergencyCostEntryId], references: [id])

  @@index([overheadEntryId])
  @@index([claimFileId])
  @@index([emergencyCaseId])
  @@map("overhead_allocations")
}

// ─── Rapor Şablonları ──────────────────────────────────────────────────────────

model ReportTemplate {
  id          String   @id @default(uuid())
  name        String
  serviceType String   @map("service_type")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items ReportTemplateItem[]

  @@index([serviceType])
  @@map("report_templates")
}

model ReportTemplateItem {
  id              String   @id @default(uuid())
  templateId      String   @map("template_id")
  workGroupId     String?  @map("work_group_id")
  damageCategory  String   @default("bina") @map("damage_category")
  location        String?
  jobDescription  String   @map("job_description")
  description     String?
  defaultQuantity Float    @default(1) @map("default_quantity")
  defaultUnit     String   @default("adet") @map("default_unit")
  pricingType     String   @default("unit") @map("pricing_type")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  template  ReportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  workGroup WorkGroup?     @relation(fields: [workGroupId], references: [id])

  @@index([templateId])
  @@map("report_template_items")
}

// ─── Acil Yardım Operasyon Modülü ────────────────────────────────────────────

enum EmergencyStatus {
  GELEN
  ATANDI
  SAHADA
  COZULDU
  FATURALANDILDI

  @@map("emergency_status")
}

enum EmergencyUrgency {
  DUSUK
  NORMAL
  YUKSEK
  KRITIK

  @@map("emergency_urgency")
}

model EmergencyCase {
  id               String           @id @default(uuid())
  caseNo           String           @unique @map("case_no")
  fileNo           String?          @map("file_no")
  customerId       String?          @map("customer_id")
  customerName     String           @map("customer_name")
  customerPhone    String?          @map("customer_phone")
  address          String
  city             String?
  district         String?
  issueType        String           @map("issue_type")
  urgency          EmergencyUrgency @default(NORMAL)
  status           EmergencyStatus  @default(GELEN)
  assignedVendorId String?          @map("assigned_vendor_id")
  assignedUserId   String?          @map("assigned_user_id")
  notes            String?
  findingsText     String?          @map("findings_text")
  fileDate         DateTime         @default(now()) @map("file_date")
  resolvedAt       DateTime?        @map("resolved_at")
  invoicedAt       DateTime?        @map("invoiced_at")
  createdByUserId  String           @map("created_by_user_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  customer       Customer?  @relation("EmergencyCustomer", fields: [customerId], references: [id])
  assignedVendor Vendor?    @relation("EmergencyVendor", fields: [assignedVendorId], references: [id])
  assignedUser   User?      @relation("EmergencyAssignedUser", fields: [assignedUserId], references: [id])
  createdBy      User       @relation("EmergencyCreatedBy", fields: [createdByUserId], references: [id])
  costEntries         EmergencyCostEntry[]
  invoiceItems        EmergencyInvoiceItem[]
  overheadAllocations OverheadAllocation[]
  // Dosya Evrak & Fatura Talebi
  fileDocuments  FileDocument[]
  invoiceRequests InvoiceRequest[]
  inboundMessages InboundMessage[]

  @@index([status])
  @@index([urgency])
  @@index([fileDate])
  @@index([createdAt])
  @@map("emergency_cases")
}

model EmergencyCostEntry {
  id                String    @id @default(uuid())
  caseId            String    @map("case_id")
  vendorId          String?   @map("vendor_id")
  entryType         String    @map("entry_type")
  description       String
  amount            Float
  receiptKey        String?   @map("receipt_key")
  entryDate         DateTime  @map("entry_date")
  isOverhead        Boolean   @default(false) @map("is_overhead")
  source            String?
  expenseCategoryId String?   @map("expense_category_id")
  createdByUserId   String    @map("created_by_user_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  case               EmergencyCase       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  vendor             Vendor?             @relation("EmergencyCostVendor", fields: [vendorId], references: [id], onDelete: SetNull)
  expenseCategory    ExpenseCategory?    @relation(fields: [expenseCategoryId], references: [id])
  createdBy          User                @relation("EmergencyCostCreatedBy", fields: [createdByUserId], references: [id])
  overheadAllocation OverheadAllocation?

  @@index([caseId])
  @@index([entryType])
  @@index([vendorId])
  @@index([isOverhead])
  @@map("emergency_cost_entries")
}

model EmergencyInvoiceDraft {
  id              String    @id @default(uuid())
  draftNo         String    @unique @map("draft_no")
  customerId      String?   @map("customer_id")
  customerName    String    @map("customer_name")
  totalAmount     Float     @default(0) @map("total_amount")
  status          String    @default("draft")
  logoRef         String?   @map("logo_ref")
  notes           String?
  createdByUserId String    @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  createdBy User                   @relation("EmergencyInvoiceCreatedBy", fields: [createdByUserId], references: [id])
  items     EmergencyInvoiceItem[]

  @@index([status])
  @@map("emergency_invoice_drafts")
}

model EmergencyInvoiceItem {
  id          String    @id @default(uuid())
  draftId     String    @map("draft_id")
  caseId      String    @map("case_id")
  amount      Float
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")

  draft EmergencyInvoiceDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  case  EmergencyCase         @relation(fields: [caseId], references: [id])

  @@index([draftId])
  @@index([caseId])
  @@map("emergency_invoice_items")
}

// ─── Tedarikçi Sözleşme Sistemi ──────────────────────────────────────────────

model VendorContractTemplate {
  id        String   @id @default(uuid())
  name      String   @default("Tedarikçi Onarım Sözleşmesi")
  isActive  Boolean  @default(true) @map("is_active")
  version   String   @default("1.0")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clauses   VendorContractClause[]
  contracts VendorContract[]

  @@map("vendor_contract_templates")
}

model VendorContractClause {
  id         String   @id @default(uuid())
  templateId String   @map("template_id")
  title      String
  content    String   @db.Text
  sortOrder  Int      @default(0) @map("sort_order")
  isRequired Boolean  @default(true) @map("is_required")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  template VendorContractTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, sortOrder])
  @@map("vendor_contract_clauses")
}

model VendorContract {
  id                   String    @id @default(uuid())
  contractNo           String    @unique @map("contract_no")
  claimFileId          String    @map("claim_file_id")
  vendorId             String    @map("vendor_id")
  repairReportId       String?   @map("repair_report_id")
  templateId           String    @map("template_id")
  contractDate         DateTime  @map("contract_date")
  startDate            DateTime? @map("start_date")
  deliveryDate         DateTime? @map("delivery_date")
  vendorName           String    @map("vendor_name")
  vendorTaxOrIdNo      String?   @map("vendor_tax_or_id_no")
  vendorAddress        String?   @map("vendor_address")
  vendorPhone          String?   @map("vendor_phone")
  insuredName          String?   @map("insured_name")
  fileNo               String    @map("file_no")
  insuranceCompanyName String?   @map("insurance_company_name")
  damageAddress        String?   @map("damage_address")
  workItems            Json      @default("[]") @map("work_items")
  renderedContent      String    @db.Text @map("rendered_content")
  status               String    @default("draft")
  signedAt             DateTime? @map("signed_at")
  vendorSignatureData  String?   @map("vendor_signature_data")
  whatsappSentAt       DateTime? @map("whatsapp_sent_at")
  whatsappPhone        String?   @map("whatsapp_phone")
  reminderCount        Int       @default(0) @map("reminder_count")
  lastReminderAt       DateTime? @map("last_reminder_at")
  signDeadlineAt       DateTime? @map("sign_deadline_at")
  createdByUserId      String    @map("created_by_user_id")
  pdfStorageKey        String?   @map("pdf_storage_key")
  publicToken          String?   @unique @map("public_token")
  publicTokenExpiresAt DateTime? @map("public_token_expires_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  claimFile    ClaimFile              @relation(fields: [claimFileId], references: [id])
  vendor       Vendor                 @relation(fields: [vendorId], references: [id])
  repairReport RepairReport?          @relation(fields: [repairReportId], references: [id])
  template     VendorContractTemplate @relation(fields: [templateId], references: [id])
  createdBy    User                   @relation("CreatedVendorContracts", fields: [createdByUserId], references: [id])

  @@index([claimFileId])
  @@index([vendorId])
  @@index([status])
  @@index([publicToken])
  @@map("vendor_contracts")
}

// ─── Dosya Evrak Sistemi (Muvafakatname / Matbu Evrak) ────────────────────────

model FileDocument {
  id                       String    @id @default(uuid())
  entityType               String    @map("entity_type")    // claim_file | emergency_case
  entityId                 String    @map("entity_id")
  documentKind             String    @map("document_kind")  // muvafakatname | matbu_evrak
  status                   String    @default("draft")
  // draft | sent | viewed | digitally_approved | physically_uploaded

  renderedContent          String    @db.Text @map("rendered_content")

  // Dijital onay
  publicToken              String?   @unique @map("public_token")
  publicTokenExpiresAt     DateTime? @map("public_token_expires_at")
  whatsappSentAt           DateTime? @map("whatsapp_sent_at")
  whatsappPhone            String?   @map("whatsapp_phone")
  viewedAt                 DateTime? @map("viewed_at")
  viewedIp                 String?   @map("viewed_ip")
  digitallyApprovedAt      DateTime? @map("digitally_approved_at")
  approvedIp               String?   @map("approved_ip")
  approvedFullName         String?   @map("approved_full_name")
  signatureData            String?   @map("signature_data")

  // Fiziki yükleme (yalnızca hasar/muvafakatname için zorunlu)
  physicalUploadKey        String?   @map("physical_upload_key")
  physicalUploadedAt       DateTime? @map("physically_uploaded_at")
  physicalUploadedByUserId String?   @map("physical_uploaded_by_user_id")

  // Polymorphic relations
  claimFileId              String?   @map("claim_file_id")
  emergencyCaseId          String?   @map("emergency_case_id")

  createdByUserId          String    @map("created_by_user_id")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  claimFile           ClaimFile?    @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  emergencyCase       EmergencyCase? @relation(fields: [emergencyCaseId], references: [id], onDelete: Cascade)
  createdBy           User          @relation("CreatedFileDocuments", fields: [createdByUserId], references: [id])
  physicalUploadedBy  User?         @relation("PhysicalUploadedBy", fields: [physicalUploadedByUserId], references: [id])

  @@index([entityType, entityId])
  @@index([publicToken])
  @@index([status])
  @@index([claimFileId])
  @@index([emergencyCaseId])
  @@map("file_documents")
}

// ─── Fatura Talebi Sistemi ─────────────────────────────────────────────────────

model InvoiceRequest {
  id                   String    @id @default(uuid())
  requestNo            String    @unique @map("request_no")       // FT-2026-00001
  serviceType          String    @map("service_type")             // claim | emergency

  claimFileId          String?   @map("claim_file_id")
  emergencyCaseId      String?   @map("emergency_case_id")

  insuranceCompanyId   String?   @map("insurance_company_id")
  insuranceCompanyName String?   @map("insurance_company_name")   // denormalized
  fileNo               String    @map("file_no")

  totalAmount          Float     @default(0) @map("total_amount")
  workItemsSummary     Json      @default("[]") @map("work_items_summary")
  // [{ description: string, amount: number, vatRate: number }]

  status               String    @default("pending")
  // pending | approved | invoiced | cancelled

  invoiceId            String?   @map("invoice_id")

  notes                String?
  createdByUserId      String    @map("created_by_user_id")
  approvedByUserId     String?   @map("approved_by_user_id")
  approvedAt           DateTime? @map("approved_at")
  invoicedAt           DateTime? @map("invoiced_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  claimFile          ClaimFile?        @relation(fields: [claimFileId], references: [id])
  emergencyCase      EmergencyCase?    @relation(fields: [emergencyCaseId], references: [id])
  insuranceCompany   InsuranceCompany? @relation(fields: [insuranceCompanyId], references: [id])
  createdBy          User              @relation("CreatedInvoiceRequests", fields: [createdByUserId], references: [id])
  approvedBy         User?             @relation("ApprovedInvoiceRequests", fields: [approvedByUserId], references: [id])
  invoice            Invoice?          @relation(fields: [invoiceId], references: [id])
  surveyCampaign     SurveyCampaign?

  @@index([status])
  @@index([claimFileId])
  @@index([emergencyCaseId])
  @@index([serviceType])
  @@map("invoice_requests")
}

// ─── Müşteri Memnuniyet Anket Sistemi ─────────────────────────────────────────

model SurveyCampaign {
  id                   String    @id @default(uuid())
  claimFileId          String?   @map("claim_file_id")
  emergencyCaseId      String?   @map("emergency_case_id")
  invoiceRequestId     String?   @unique @map("invoice_request_id")
  insuranceCompanyId   String?   @map("insurance_company_id")
  insuredName          String?   @map("insured_name")
  insuredPhone         String?   @map("insured_phone")
  publicToken          String    @unique @map("public_token")
  tokenExpiresAt       DateTime? @map("token_expires_at")
  whatsappSentAt       DateTime? @map("whatsapp_sent_at")
  whatsappDeepLink     String?   @map("whatsapp_deep_link")
  status               String    @default("pending")
  // pending | sent | completed | expired
  completedAt          DateTime? @map("completed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  claimFile        ClaimFile?        @relation(fields: [claimFileId], references: [id])
  insuranceCompany InsuranceCompany? @relation(fields: [insuranceCompanyId], references: [id])
  invoiceRequest   InvoiceRequest?   @relation(fields: [invoiceRequestId], references: [id])
  response         SurveyResponse?

