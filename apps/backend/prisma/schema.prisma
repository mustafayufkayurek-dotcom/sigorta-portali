enum VendorStatementStatus {
  DRAFT
  SENT
  PARTIALLY_APPROVED
  APPROVED
  DISPUTED
  CLOSED

  @@map("vendor_statement_status")
}

enum VendorStatementItemApprovalStatus {
  PENDING
  APPROVED
  DISPUTED
  AUTO_APPROVED

  @@map("vendor_statement_item_approval_status")
}

enum VendorDisputeReason {
  AMOUNT_MISMATCH
  ITEM_NOT_DONE
  WRONG_CLAIM
  NOT_RECEIVED
  OTHER

  @@map("vendor_dispute_reason")
}

enum VendorDisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_ACCEPT
  RESOLVED_REJECT
  WITHDRAWN

  @@map("vendor_dispute_status")
}

enum VendorDisputeAlertType {
  HIGH_DISPUTE_RATE
  REPEATED_DISPUTE_SAME_ITEM
  BULK_DISPUTE

  @@map("vendor_dispute_alert_type")
}

model VendorPaymentStatement {
  id              String                  @id @default(uuid())
  vendorId        String                  @map("vendor_id")
  statementNo     String                  @unique @map("statement_no")
  periodStart     DateTime                @map("period_start")
  periodEnd       DateTime                @map("period_end")
  totalAmount     Float                   @default(0) @map("total_amount")
  currency        String                  @default("TRY")
  status          VendorStatementStatus   @default(DRAFT)
  sentAt          DateTime?               @map("sent_at")
  deadlineAt      DateTime?               @map("deadline_at")
  autoApprovedAt  DateTime?               @map("auto_approved_at")
  createdByUserId String                  @map("created_by_user_id")
  notes           String?
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  vendor       Vendor                    @relation(fields: [vendorId], references: [id])
  createdBy    User                      @relation("CreatedVendorStatements", fields: [createdByUserId], references: [id])
  items        VendorStatementItem[]
  receipts     VendorStatementReceipt[]
  tokens       VendorStatementToken[]
  disputeAlerts VendorDisputeAlert[]

  @@index([vendorId])
  @@index([status])
  @@index([deadlineAt])
  @@map("vendor_payment_statements")
}

model VendorStatementItem {
  id                  String                              @id @default(uuid())
  statementId         String                              @map("statement_id")
  paymentId           String?                             @map("payment_id")
  claimFileId         String                              @map("claim_file_id")
  repairReportItemId  String?                             @map("repair_report_item_id")
  workGroupId         String?                             @map("work_group_id")
  lineDescription     String                              @map("line_description")
  quantity            Float                               @default(1)
  unit                String?
  unitPrice           Float                               @map("unit_price")
  totalAmount         Float                               @map("total_amount")
  vatRate             Float                               @default(18) @map("vat_rate")
  receiptRef          String?                             @map("receipt_ref")
  receiptDate         DateTime?                           @map("receipt_date")
  approvalStatus      VendorStatementItemApprovalStatus   @default(PENDING)
  approvedAt          DateTime?                           @map("approved_at")
  disputedAt          DateTime?                           @map("disputed_at")
  sortOrder           Int                                 @default(0) @map("sort_order")
  createdAt           DateTime                            @default(now()) @map("created_at")
  updatedAt           DateTime                            @updatedAt @map("updated_at")

  statement        VendorPaymentStatement  @relation(fields: [statementId], references: [id], onDelete: Cascade)
  payment          Payment?                @relation(fields: [paymentId], references: [id])
  vendorPayment    Payment?                @relation("StatementItemPayment")
  claimFile        ClaimFile               @relation(fields: [claimFileId], references: [id])
  repairReportItem RepairReportItem?       @relation(fields: [repairReportItemId], references: [id])
  workGroup        WorkGroup?              @relation(fields: [workGroupId], references: [id])
  disputeRecord    VendorStatementDispute?

  @@index([statementId])
  @@index([claimFileId])
  @@index([approvalStatus])
  @@map("vendor_statement_items")
}

model VendorStatementReceipt {
  id              String    @id @default(uuid())
  statementId     String    @map("statement_id")
  paymentId       String?   @map("payment_id")
  storageKey      String    @map("storage_key")
  fileName        String    @map("file_name")
  mimeType        String    @map("mime_type")
  fileSize        Int       @map("file_size")
  bankRef         String?   @map("bank_ref")
  bankDate        DateTime? @map("bank_date")
  amount          Float
  uploadedByUserId String   @map("uploaded_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  statement  VendorPaymentStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  payment    Payment?               @relation(fields: [paymentId], references: [id])
  uploadedBy User                   @relation("UploadedStatementReceipts", fields: [uploadedByUserId], references: [id])

  @@index([statementId])
  @@map("vendor_statement_receipts")
}

model VendorStatementDispute {
  id               String               @id @default(uuid())
  statementItemId  String               @unique @map("statement_item_id")
  vendorId         String               @map("vendor_id")
  reason           VendorDisputeReason
  reasonNote       String               @map("reason_note")
  evidenceStorageKey String?            @map("evidence_storage_key")
  evidenceFileName   String?            @map("evidence_file_name")
  status           VendorDisputeStatus  @default(OPEN)
  resolvedAt       DateTime?            @map("resolved_at")
  resolvedByUserId String?              @map("resolved_by_user_id")
  resolvedNote     String?              @map("resolved_note")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  statementItem   VendorStatementItem @relation(fields: [statementItemId], references: [id], onDelete: Cascade)
