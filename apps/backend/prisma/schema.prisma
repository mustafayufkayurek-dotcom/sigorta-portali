enum TaskAssignmentStatus {
  PENDING_APPROVAL
  APPROVED
  IN_PROGRESS
  COMPLETED
  REJECTED
  TIMEOUT_AUTO_ASSIGNED

  @@map("task_assignment_status")
}

enum TaskAssignmentPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("task_assignment_priority")
}

enum AssignmentNotificationType {
  ASSIGNMENT
  REMINDER
  TIMEOUT_WARNING
  ESCALATION
  OVERDUE

  @@map("assignment_notification_type")
}

model TaskAssignment {
  id             String                 @id @default(uuid())
  claimFileId    String                 @map("claim_file_id")
  assignedToId   String                 @map("assigned_to_id")
  assignedById   String?                @map("assigned_by_id")
  status         TaskAssignmentStatus   @default(PENDING_APPROVAL)
