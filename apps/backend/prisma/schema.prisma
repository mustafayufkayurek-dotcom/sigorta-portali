  updatedAt      DateTime               @updatedAt @map("updated_at")

  claimFile    ClaimFile @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  assignedTo   User      @relation("TaskAssignmentAssignedTo", fields: [assignedToId], references: [id])
  assignedBy   User?     @relation("TaskAssignmentAssignedBy", fields: [assignedById], references: [id])

  notifications AssignmentNotification[]

  @@index([claimFileId])
  @@index([assignedToId])
  @@index([status])
  @@map("task_assignments")
}

model AssignmentRule {
  id              String   @id @default(uuid())
