  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  payments Payment[]

  @@map("bank_accounts")
}

model Invoice {
  id                 String   @id @default(uuid())
  claimFileId        String   @map("claim_file_id")
  invoiceType        String   @map("invoice_type")        // sales | purchase
  invoiceNo          String   @unique @map("invoice_no")
  invoiceDate        DateTime @map("invoice_date")
  dueDate            DateTime? @map("due_date")
  counterpartyType   String   @map("counterparty_type")   // insurance_company | vendor | customer
  counterpartyId     String?  @map("counterparty_id")
  currency           String   @default("TRY")
  subtotalAmount     Float    @default(0) @map("subtotal_amount")
  vatAmount          Float    @default(0) @map("vat_amount")
  withholdingAmount  Float    @default(0) @map("withholding_amount")
  totalAmount        Float    @default(0) @map("total_amount")
  status             String   @default("draft")           // draft | sent | paid | partial | cancelled | overdue
  documentFileId     String?  @map("document_file_id")
  createdByUserId    String   @map("created_by_user_id")
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  claimFile   ClaimFile @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("CreatedInvoices", fields: [createdByUserId], references: [id])
  payments    Payment[]
  // P&L Faz 3
  fileRevenues ClaimFileRevenue[]
  // Fatura Talebi
  invoiceRequests InvoiceRequest[]

  @@index([claimFileId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model Payment {
  id              String   @id @default(uuid())
  claimFileId     String   @map("claim_file_id")
  paymentType     String   @map("payment_type")    // incoming | outgoing
  paymentDate     DateTime @map("payment_date")
  amount          Float
  currency        String   @default("TRY")
  method          String                            // eft | havale | credit_card | cash | offset
  payerType       String   @map("payer_type")      // insurance_company | vendor | customer
  payerId         String?  @map("payer_id")
  invoiceId       String?  @map("invoice_id")
  referenceNo     String?  @map("reference_no")
  status          String   @default("completed")   // pending | completed | cancelled
  bankAccountId   String?  @map("bank_account_id")
  note            String?
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  claimFile   ClaimFile    @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id])
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])
  createdBy   User         @relation("CreatedPayments", fields: [createdByUserId], references: [id])
  statementItems    VendorStatementItem[]
  statementReceipts VendorStatementReceipt[]
  // P&L Faz 3
  revenueRecords ClaimFileRevenue[] @relation("RevenuePayment")

  @@index([claimFileId])
  @@index([invoiceId])
  @@index([status])
  @@map("payments")
}

model ClaimFinancialSummary {
  id               String   @id @default(uuid())
  claimFileId      String   @unique @map("claim_file_id")
  estimatedRevenue Float    @default(0) @map("estimated_revenue")
  actualRevenue    Float    @default(0) @map("actual_revenue")
