// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model InsuranceCompany {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  taxNumber    String?  @map("tax_number")
  contactEmail String?  @map("contact_email")
  contactPhone String?  @map("contact_phone")
  address      String?
  status       String   @default("active")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  claimFiles               ClaimFile[]
  userInsuranceCompanyScopes UserInsuranceCompanyScope[]
  invoiceRequests          InvoiceRequest[]
  surveyCampaigns          SurveyCampaign[]

  @@map("insurance_companies")
}

model Branch {
  id            String   @id @default(uuid())
  name          String
  city          String?
  region        String?
  address       String?
  phone         String?
  managerUserId String?  @map("manager_user_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  users              User[]        @relation("BranchUsers")
  manager            User?         @relation("BranchManager", fields: [managerUserId], references: [id])
  assignedClaimFiles ClaimFile[]

  @@map("branches")
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  module      String
  action      String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String    @id @default(uuid())
  branchId     String?   @map("branch_id")
  roleId       String    @map("role_id")
  adjusterId   String?   @unique @map("adjuster_id")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  email        String    @unique
  phone        String?
  passwordHash String    @map("password_hash")
  status       String    @default("active")
  lastLoginAt  DateTime? @map("last_login_at")
  employeeCode String?   @unique @map("employee_code")
  isMobileUser Boolean   @default(false) @map("is_mobile_user")
  isWebUser    Boolean   @default(true) @map("is_web_user")
  expoPushToken String?  @map("expo_push_token")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  branch   Branch?   @relation("BranchUsers", fields: [branchId], references: [id])
  role     Role      @relation(fields: [roleId], references: [id])
  adjuster Adjuster? @relation("UserAdjuster", fields: [adjusterId], references: [id])

  managedBranches            Branch[]                    @relation("BranchManager")
  userInsuranceCompanyScopes UserInsuranceCompanyScope[]
  assignedFieldClaimFiles    ClaimFile[]                 @relation("AssignedFieldUser")
  assignedOfficeClaimFiles   ClaimFile[]                 @relation("AssignedOfficeUser")
  assignedAdjusterClaimFiles ClaimFile[]                 @relation("AssignedAdjuster")
  responsibleClaimFiles      ClaimFile[]                 @relation("CurrentResponsibleUser")
  claimStatusChanges         ClaimStatusHistory[]
  waitingsCreated            ClaimFileWaiting[] @relation("WaitingCreatedBy")
  waitingsResolved           ClaimFileWaiting[] @relation("WaitingResolvedBy")
  timelineNotes              TimelineNote[]     @relation("TimelineNoteAuthor")
  tasks                      Task[]
  notes                      Note[]
  uploadedFileAssets         FileAsset[]
  performedAuditLogs         AuditLog[]
  notifications              Notification[]
  refreshTokens              RefreshToken[]
  passwordResetTokens        PasswordResetToken[]
  createdRepairReports       RepairReport[]              @relation("CreatedRepairReports")
  revisedRepairReports       RepairReport[]              @relation("RevisedRepairReports")
  uploadedVendorDocuments    VendorDocument[]
  approvalActions            ReportApprovalHistory[]
  sentExternalApprovals      ExternalApproval[]          @relation("SentExternalApprovals")
  externalApprovalResponses  ExternalApproval[]          @relation("ExternalApprovalResponder")
  createdInvoices            Invoice[]                   @relation("CreatedInvoices")
  createdPayments            Payment[]                   @relation("CreatedPayments")
  serviceAreas               UserServiceArea[]
  assignedAppointments       Appointment[]               @relation("AppointmentUser")
  userLocations              UserLocation[]
  customerAccessLogs         CustomerAccessLog[]
  uploadedEntityDocuments    EntityDocument[]            @relation("UploadedEntityDocuments")
  chatArchives               ChatArchive[]
  taskAssignmentsAssigned    TaskAssignment[] @relation("TaskAssignmentAssignedTo")
  taskAssignmentsAssignedBy  TaskAssignment[] @relation("TaskAssignmentAssignedBy")
  assignmentRules            AssignmentRule[] @relation("AssignmentRuleUser")
  revisionRequestsMade       ReportRevisionRequest[] @relation("RevisionRequestedBy")
  revisionRequestsAssigned   ReportRevisionRequest[] @relation("RevisionAssignedTo")
  revisionMessages           RevisionMessage[] @relation("RevisionMessageSender")
  emailPreferences           UserEmailPreferences?
  agreementAcceptances       AgreementAcceptance[]
  createdVendorStatements    VendorPaymentStatement[]  @relation("CreatedVendorStatements")
  uploadedStatementReceipts  VendorStatementReceipt[]  @relation("UploadedStatementReceipts")
  resolvedVendorDisputes     VendorStatementDispute[]  @relation("ResolvedVendorDisputes")
  acknowledgedVendorAlerts   VendorDisputeAlert[]      @relation("AcknowledgedVendorAlerts")
  // P&L Faz 3
  createdExtraWorkItems      ExtraWorkItem[]           @relation("CreatedExtraWorkItems")
  createdFileRevenues        ClaimFileRevenue[]        @relation("CreatedFileRevenues")
  createdOverheadEntries     MonthlyOverheadEntry[]    @relation("CreatedOverheadEntries")
  // Acil Yardım
  emergencyCasesCreated      EmergencyCase[]           @relation("EmergencyCreatedBy")
  emergencyCasesAssigned     EmergencyCase[]           @relation("EmergencyAssignedUser")
  emergencyCostEntries       EmergencyCostEntry[]      @relation("EmergencyCostCreatedBy")
  emergencyInvoicesCreated   EmergencyInvoiceDraft[]   @relation("EmergencyInvoiceCreatedBy")
  // Tedarikçi Sözleşmeleri
  createdVendorContracts     VendorContract[]          @relation("CreatedVendorContracts")
  // Dosya Evrak Sistemi
  createdFileDocuments       FileDocument[]            @relation("CreatedFileDocuments")
  physicalUploadedDocuments  FileDocument[]            @relation("PhysicalUploadedBy")
  // Fatura Talepleri
  createdInvoiceRequests     InvoiceRequest[]          @relation("CreatedInvoiceRequests")
  approvedInvoiceRequests    InvoiceRequest[]          @relation("ApprovedInvoiceRequests")
  // Ekran İzinleri
  screenPermissions          ScreenPermission[]
  // Masraf İzleme
  createdExpenses            Expense[]                 @relation("ExpenseCreatedBy")
  approvedExpenses           Expense[]                 @relation("ExpenseApprovedBy")

  // Ofis-Saha İş Akışı
  fileActivityLogs           FileActivityLog[]         @relation("FileActivityActor")
  createdFileAppointments    FileAppointment[]         @relation("FileAppointmentCreatedBy")

  @@index([email])
  @@index([roleId])
  @@index([branchId])
  @@map("users")
}

model UserInsuranceCompanyScope {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  insuranceCompanyId String   @map("insurance_company_id")
  createdAt          DateTime @default(now()) @map("created_at")

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  insuranceCompany InsuranceCompany @relation(fields: [insuranceCompanyId], references: [id], onDelete: Cascade)

  @@unique([userId, insuranceCompanyId])
  @@map("user_insurance_company_scopes")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

model ClaimFile {
  id                    String    @id @default(uuid())
  fileNo                String    @unique @map("file_no")
  insuranceCompanyId    String    @map("insurance_company_id")
  policyNo              String    @map("policy_no")
  claimNo               String    @map("claim_no")
  productBranch         String    @map("product_branch")
  lossType              String?   @map("loss_type")
  incidentDate          DateTime  @map("incident_date")
  notificationDate      DateTime  @map("notification_date")
  currentStatusId       String    @map("current_status_id")
  priority              String    @default("medium")
  sourceChannel         String?   @map("source_channel")
  customerId            String?   @map("customer_id")
  propertyType          String?   @map("property_type")
  propertyAddressId     String?   @map("property_address_id")
  fileType              String?   @map("file_type")
  description           String?
  initialReserveAmount  Float?    @map("initial_reserve_amount")
  estimatedCostAmount   Float?    @map("estimated_cost_amount")
  approvedBudgetAmount  Float?    @map("approved_budget_amount")
  actualCostAmount      Float?    @map("actual_cost_amount")
  invoicedAmount        Float?    @map("invoiced_amount")
  collectedAmount       Float?    @map("collected_amount")
  profitAmount          Float?    @map("profit_amount")
  currency              String    @default("TRY")
  assignedBranchId      String?   @map("assigned_branch_id")
  assignedTeamId        String?   @map("assigned_team_id")
  assignedFieldUserId   String?   @map("assigned_field_user_id")
  assignedOfficeUserId  String?   @map("assigned_office_user_id")
  assignedAdjusterId    String?   @map("assigned_adjuster_id")
  assignedSupplierId    String?   @map("assigned_supplier_id")
  supplierAssignedAt    DateTime? @map("supplier_assigned_at")
  slaDueAt              DateTime? @map("sla_due_at")
  departmentId          String?   @map("department_id")
  departmentFileSubjectId String? @map("department_file_subject_id")
  // Operasyonel Ownership (Danışman Ek Talep #1)
  currentResponsibleRole  String?   @map("current_responsible_role")
  currentResponsibleUserId String?  @map("current_responsible_user_id")
  pendingActionOwner      String?   @map("pending_action_owner")

  // Son Aktivite Takibi (Danışman Ek Talep #2)
  lastActivityAt          DateTime? @map("last_activity_at")
  lastHumanActionAt       DateTime? @map("last_human_action_at")
  statusChangedAt         DateTime? @map("status_changed_at")

  // Eksper Portal İhbar Ek Bilgileri
  policyType            String?   @map("policy_type")         // bireysel | ticari
  commercialTitle       String?   @map("commercial_title")     // Ticari ünvan
  taxOffice             String?   @map("tax_office")           // Vergi dairesi
  taxNumber             String?   @map("tax_number")           // Vergi numarası
  insuredName           String?   @map("insured_name")         // Sigortalı adı
  insuredPhone          String?   @map("insured_phone")        // Sigortalı telefon

  closedAt              DateTime? @map("closed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  insuranceCompany InsuranceCompany @relation(fields: [insuranceCompanyId], references: [id])
  currentStatus    ClaimStatus      @relation(fields: [currentStatusId], references: [id])
  customer         Customer?        @relation(fields: [customerId], references: [id])
  propertyAddress  Address?         @relation("PropertyAddress", fields: [propertyAddressId], references: [id])
  assignedBranch   Branch?          @relation(fields: [assignedBranchId], references: [id])
  assignedFieldUser   User?         @relation("AssignedFieldUser", fields: [assignedFieldUserId], references: [id])
  assignedOfficeUser  User?         @relation("AssignedOfficeUser", fields: [assignedOfficeUserId], references: [id])
  assignedAdjuster    User?         @relation("AssignedAdjuster", fields: [assignedAdjusterId], references: [id])
  assignedSupplier    Vendor?       @relation("AssignedSupplier", fields: [assignedSupplierId], references: [id])
  currentResponsibleUser User?     @relation("CurrentResponsibleUser", fields: [currentResponsibleUserId], references: [id])
  department          Department?   @relation(fields: [departmentId], references: [id])
  departmentFileSubject DepartmentFileSubject? @relation(fields: [departmentFileSubjectId], references: [id])

  statusHistory        ClaimStatusHistory[]
  waitings             ClaimFileWaiting[]
  timelineNotes        TimelineNote[]
  riskLocations        ClaimRiskLocation[]
  tasks                Task[]
  notes                Note[]
  documents            ClaimDocument[]
  adjusterAssignments  AdjusterAssignment[]
  appointments         Appointment[]
  budgetVersions       BudgetVersion[]
  costEntries          CostEntry[]
  repairReports        RepairReport[]
  invoices             Invoice[]
  payments             Payment[]
  financialSummary     ClaimFinancialSummary?
  customerAccessLogs   CustomerAccessLog[]
  chatArchives         ChatArchive[]
  taskAssignments      TaskAssignment[]
  statementItems       VendorStatementItem[]
  // P&L Faz 3
  fileRevenues         ClaimFileRevenue[]
  extraWorkItems       ExtraWorkItem[]
  overheadAllocations  OverheadAllocation[]
  // Tedarikçi Sözleşmeleri
  vendorContracts      VendorContract[]
  // Dosya Evrak & Fatura Talebi
  fileDocuments        FileDocument[]
  invoiceRequests      InvoiceRequest[]
  // Müşteri Memnuniyet Anketi
  surveyCampaigns      SurveyCampaign[]
  // Masraf İzleme
  expenses             Expense[]

  // Ofis-Saha İş Akışı
  activityLogs         FileActivityLog[]
  fileAppointments     FileAppointment[]

  @@index([fileNo])
  @@index([insuranceCompanyId])
  @@index([currentStatusId])
  @@index([assignedFieldUserId])
  @@index([assignedOfficeUserId])
  @@index([assignedAdjusterId])
  @@map("claim_files")
}

model ClaimStatus {
  id               String   @id @default(uuid())
  code             String   @unique
  name             String
  sequenceNo       Int      @map("sequence_no")
  color            String   @default("#6B7280")
  isClosedState    Boolean  @default(false) @map("is_closed_state")
  maxDurationHours     Int?     @map("max_duration_hours")
  slaWarningPercent    Int      @default(60) @map("sla_warning_percent")
  slaCriticalPercent   Int      @default(80) @map("sla_critical_percent")
  slaEscalationPercent Int      @default(100) @map("sla_escalation_percent")
  isWaitingState       Boolean  @default(false) @map("is_waiting_state")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  claimFiles         ClaimFile[]
  historyFrom        ClaimStatusHistory[] @relation("FromStatus")
  historyTo          ClaimStatusHistory[] @relation("ToStatus")

  @@map("claim_statuses")
}

model ClaimStatusHistory {
  id              String   @id @default(uuid())
  claimFileId     String   @map("claim_file_id")
  fromStatusId    String?  @map("from_status_id")
  toStatusId      String   @map("to_status_id")
  changedByUserId String   @map("changed_by_user_id")
  changedAt       DateTime @default(now()) @map("changed_at")
  note            String?
  durationMinutes Int?     @map("duration_minutes")
  waitingReason   String?  @map("waiting_reason")

  claimFile     ClaimFile    @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  fromStatus    ClaimStatus? @relation("FromStatus", fields: [fromStatusId], references: [id])
  toStatus      ClaimStatus  @relation("ToStatus", fields: [toStatusId], references: [id])
  changedByUser User         @relation(fields: [changedByUserId], references: [id])

  @@index([claimFileId])
  @@map("claim_status_history")
}

model ClaimFileWaiting {
  id               String    @id @default(uuid())
  claimFileId      String    @map("claim_file_id")
  reason           String
  description      String?
  startedAt        DateTime  @default(now()) @map("started_at")
  resolvedAt       DateTime? @map("resolved_at")
  resolvedByUserId String?   @map("resolved_by_user_id")
  createdByUserId  String    @map("created_by_user_id")

  claimFile      ClaimFile @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  createdByUser  User      @relation("WaitingCreatedBy", fields: [createdByUserId], references: [id])
  resolvedByUser User?     @relation("WaitingResolvedBy", fields: [resolvedByUserId], references: [id])

  @@index([claimFileId])
  @@map("claim_file_waitings")
}

// Operasyonel İç Not Sistemi (Danışman Ek Talep #5)
model TimelineNote {
  id          String   @id @default(uuid())
  claimFileId String   @map("claim_file_id")
  authorId    String   @map("author_id")
  content     String
  noteType    String   @default("general") @map("note_type") // general | operations | finance | adjuster | field
  visibility  String   @default("internal") // internal | team_only
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  claimFile ClaimFile @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  author    User      @relation("TimelineNoteAuthor", fields: [authorId], references: [id])

  @@index([claimFileId])
  @@map("timeline_notes")
}

model Customer {
  id              String    @id @default(uuid())
  type            String
  // Yeni: entityType (individual/corporate) ve subType (insured/private_customer)
  entityType      String    @default("individual") @map("entity_type") // individual | corporate
  subType         String?   @map("sub_type")        // insured | private_customer (bireysel için)
  identityNo      String?   @unique @map("identity_no")
  taxNumber       String?   @unique @map("tax_number")
  taxOffice       String?   @map("tax_office")
  fullName        String?   @map("full_name")
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  companyName     String?   @map("company_name")
  authorizedPerson String?  @map("authorized_person")
  contactFirstName String?  @map("contact_first_name")
  contactLastName  String?  @map("contact_last_name")
  phone           String?
  email           String?
  city            String?
  district        String?
  address         String?
  birthDate       DateTime? @map("birth_date")
  latitude        Float?
  longitude       Float?
  // Hizmet türü ve branşlar
  serviceType     String?   @map("service_type")       // HASAR | ACIL_YARDIM
  serviceBranches Json?     @default("[]") @map("service_branches") // string[]

  // CRM alanları
  source          String?   // insurance_referral | referral | web | returning
  satisfactionScore Int?    @map("satisfaction_score") // 1-5
  followUpDate    DateTime? @map("follow_up_date")
  tags            Json?     @default("[]")
  status          String    @default("active") // active | passive | blacklisted
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  claimFiles   ClaimFile[]
  contacts     CustomerContact[]
  contactInfos ContactInfo[]
  accessLogs   CustomerAccessLog[]
  expertReports RepairReport[]     @relation("ExpertOfficeReports")
  emergencyCases EmergencyCase[]   @relation("EmergencyCustomer")

  @@map("customers")
}

model CustomerContact {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  name       String
  role       String?
  phone      String?
  email      String?
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_contacts")
}

model Address {
  id           String   @id @default(uuid())
  title        String?
  country      String   @default("TR")
  city         String
  district     String?
  neighborhood String?
  addressLine  String   @map("address_line")
  postalCode   String?  @map("postal_code")
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  claimFilesProperty ClaimFile[]        @relation("PropertyAddress")
  riskLocations      ClaimRiskLocation[]

  @@map("addresses")
}

model ClaimRiskLocation {
  id               String   @id @default(uuid())
  claimFileId      String   @map("claim_file_id")
  addressId        String   @map("address_id")
  siteContactName  String?  @map("site_contact_name")
  siteContactPhone String?  @map("site_contact_phone")
  accessNotes      String?  @map("access_notes")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  claimFile ClaimFile @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  address   Address   @relation(fields: [addressId], references: [id])

  @@index([claimFileId])
  @@map("claim_risk_locations")
}

model Task {
  id             String    @id @default(uuid())
  claimFileId    String    @map("claim_file_id")
  taskType       String    @map("task_type")
  title          String
  description    String?
  priority       String
  status         String    @default("pending")
  assignedUserId String?   @map("assigned_user_id")
  dueAt          DateTime? @map("due_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  claimFile    ClaimFile        @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  assignedUser User?            @relation(fields: [assignedUserId], references: [id])
  checklists   TaskChecklist[]

  @@index([claimFileId])
  @@index([assignedUserId])
  @@index([status])
  @@index([dueAt])
  @@map("tasks")
}

model TaskChecklist {
  id          String   @id @default(uuid())
  taskId      String   @map("task_id")
  itemText    String   @map("item_text")
  isRequired  Boolean  @default(false) @map("is_required")
  isCompleted Boolean  @default(false) @map("is_completed")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_checklists")
}

model Note {
  id           String   @id @default(uuid())
  claimFileId  String   @map("claim_file_id")
  noteType     String   @map("note_type")
  content      String
  isPrivate    Boolean  @default(false) @map("is_private")
  authorUserId String   @map("author_user_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  claimFile ClaimFile @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorUserId], references: [id])

  @@index([claimFileId])
  @@map("notes")
}

model FileAsset {
  id            String   @id @default(uuid())
  ownerType     String   @map("owner_type")
  ownerId       String   @map("owner_id")
  fileName      String   @map("file_name")
  fileExtension String   @map("file_extension")
  mimeType      String   @map("mime_type")
  fileSize      Int      @map("file_size")
  storageKey    String   @map("storage_key")
  thumbnailKey  String?  @map("thumbnail_key")
  category      String?
  uploadedByUserId String @map("uploaded_by_user_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  uploadedBy User            @relation(fields: [uploadedByUserId], references: [id])
  documents  ClaimDocument[]
  adjusterReports AdjusterReport[]

  @@index([ownerType, ownerId])
  @@map("file_assets")
}

model ClaimDocument {
  id           String   @id @default(uuid())
  claimFileId  String   @map("claim_file_id")
  fileAssetId  String   @map("file_asset_id")
  documentType String   @map("document_type")
  visibility   AttachmentVisibility @default(PUBLIC)
  versionNo    Int      @default(1) @map("version_no")
  isLatest     Boolean  @default(true) @map("is_latest")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  claimFile ClaimFile @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  fileAsset FileAsset @relation(fields: [fileAssetId], references: [id])

  @@index([claimFileId])
  @@index([claimFileId, isLatest])
  @@map("claim_documents")
}

model AuditLog {
  id          String   @id @default(uuid())
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  action      String
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  userId      String?  @map("user_id")
  userEmail   String?  @map("user_email")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model Notification {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  type              String
  title             String
  body              String
  channel           String
  status            String   @default("pending")
  relatedEntityType String?  @map("related_entity_type")
  relatedEntityId   String?  @map("related_entity_id")
  createdAt         DateTime @default(now()) @map("created_at")
  readAt            DateTime? @map("read_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("notifications")
}

// ─── Faz 2: Eksper Yönetimi ────────────────────────────────────────────────────

model Adjuster {
  id           String   @id @default(uuid())
  name         String
  company      String?
  licenseNo    String?  @unique @map("license_no")
  phone        String?
  email        String?
  city         String?
  region       String?
  specialties  String[] @default([])
  status       String   @default("active")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  assignments  AdjusterAssignment[]
  appointments Appointment[]
  users        User[]              @relation("UserAdjuster")

  @@index([city])
  @@index([region])
  @@index([status])
  @@map("adjusters")
}

model AdjusterAssignment {
  id              String    @id @default(uuid())
  claimFileId     String    @map("claim_file_id")
  adjusterId      String    @map("adjuster_id")
  status          String    @default("pending")
  assignedAt      DateTime  @default(now()) @map("assigned_at")
  respondedAt     DateTime? @map("responded_at")
  appointmentDate DateTime? @map("appointment_date")
  visitDate       DateTime? @map("visit_date")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  claimFile ClaimFile @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  adjuster  Adjuster  @relation(fields: [adjusterId], references: [id])
  report    AdjusterReport?

  @@index([claimFileId])
  @@index([adjusterId])
  @@index([status])
  @@map("adjuster_assignments")
}

model AdjusterReport {
  id               String    @id @default(uuid())
  assignmentId     String    @unique @map("assignment_id")
  reportNo         String    @unique @map("report_no")
  reportDate       DateTime  @map("report_date")
  recommendation   String?
  estimatedDamage  Float?    @map("estimated_damage")
  status           String    @default("draft")
  rejectionReason  String?   @map("rejection_reason")
  fileAssetId      String?   @map("file_asset_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  assignment AdjusterAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  fileAsset  FileAsset?         @relation(fields: [fileAssetId], references: [id])

  @@index([status])
  @@map("adjuster_reports")
}

model Appointment {
  id             String    @id @default(uuid())
  claimFileId    String    @map("claim_file_id")
  adjusterId     String?   @map("adjuster_id")
  assignedUserId String?   @map("assigned_user_id")
  vendorId       String?   @map("vendor_id")
  type           String
  scheduledAt    DateTime  @map("scheduled_at")
  scheduledEnd   DateTime? @map("scheduled_end")
  completedAt    DateTime? @map("completed_at")
  notifiedAt     DateTime? @map("notified_at")
  location       String?
  notes          String?
  status         String    @default("planned")
  checkedInAt        DateTime? @map("checked_in_at")
  checkedInLatitude  Float?    @map("checked_in_latitude")
  checkedInLongitude Float?    @map("checked_in_longitude")
  checkedOutAt       DateTime? @map("checked_out_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  claimFile    ClaimFile @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  adjuster     Adjuster? @relation(fields: [adjusterId], references: [id])
  assignedUser User?     @relation("AppointmentUser", fields: [assignedUserId], references: [id])
  vendor       Vendor?   @relation(fields: [vendorId], references: [id])

  @@index([claimFileId])
  @@index([adjusterId])
  @@index([assignedUserId])
  @@index([scheduledAt])
  @@map("appointments")
}

// ─── Faz 2: Bütçe Yönetimi ────────────────────────────────────────────────────

model Province {
  id        String     @id @default(uuid())
  plateCode Int        @unique @map("plate_code")
  name      String     @unique
  districts District[]
  serviceAreas     VendorServiceArea[]
  userServiceAreas UserServiceArea[]

  @@map("provinces")
}

model District {
  id         String   @id @default(uuid())
  provinceId String   @map("province_id")
  name       String
  province   Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  serviceAreas     VendorServiceArea[]
  userServiceAreas UserServiceArea[]

  @@unique([provinceId, name])
  @@index([provinceId])
  @@map("districts")
}

model Vendor {
  id               String   @id @default(uuid())
  name             String
  type             String
  entityType       String   @default("corporate") @map("entity_type") // corporate | individual
  taxNumber        String?  @unique @map("tax_number")
  taxOffice        String?  @map("tax_office")
  tradeRegistryNo  String?  @map("trade_registry_no")
  authorizedPerson String?  @map("authorized_person")
  authorizedPhone  String?  @map("authorized_phone")
  authorizedEmail  String?  @map("authorized_email")
  identityNo       String?  @unique @map("identity_no")
  phone            String?
  email            String?
  address          String?
  city             String?
  district         String?
  latitude         Float?
  longitude        Float?
  iban             String?
  bankName         String?  @map("bank_name")
  // CRM alanları
  source           String?  // referral | web | direct | other
  referral         String?  // Bu tedarikçiyi kim önerdi/tanıştırdı
  tags             Json?    @default("[]")
  notes            String?
  // Sözleşme / Vade takip
  contractStartDate DateTime? @map("contract_start_date")
  contractEndDate   DateTime? @map("contract_end_date")
  contractNotes     String?   @map("contract_notes")
  // Tedarikçi kategorisi: hasar | acil | her_ikisi
  category         String   @default("hasar")
  status           String   @default("active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  budgetItems              BudgetItem[]
  costEntries              CostEntry[]
  serviceAreas             VendorServiceArea[]
  vendorWorkGroups         VendorWorkGroup[]
  vendorDocuments          VendorDocument[]
  appointments             Appointment[]
  contacts                 VendorContact[]
  contactInfos             ContactInfo[]
  vendorStatements         VendorPaymentStatement[]
  statementDisputes        VendorStatementDispute[]
  disputeAlerts            VendorDisputeAlert[]
  riskScore                VendorRiskScore?
  riskScoreHistory         VendorRiskScoreHistory[]
  concentrationSnapshots   VendorConcentrationSnapshot[]
  emergencyCases           EmergencyCase[]             @relation("EmergencyVendor")
  emergencyCostEntries     EmergencyCostEntry[]        @relation("EmergencyCostVendor")
  // Tedarikçi Sözleşmeleri
  vendorContracts          VendorContract[]

  // Ofis-Saha: Atanmış Dosyalar
  assignedClaimFiles       ClaimFile[]     @relation("AssignedSupplier")

  @@index([status])
  @@index([category])
  @@map("vendors")
}

model VendorServiceArea {
  id         String    @id @default(uuid())
  vendorId   String    @map("vendor_id")
  provinceId String    @map("province_id")
  districtId String?   @map("district_id")

  vendor   Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  province Province  @relation(fields: [provinceId], references: [id])
  district District? @relation(fields: [districtId], references: [id])

  @@unique([vendorId, provinceId, districtId])
  @@index([vendorId])
  @@map("vendor_service_areas")
}

model UserServiceArea {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  provinceId String    @map("province_id")
  districtId String?   @map("district_id")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  province Province  @relation(fields: [provinceId], references: [id])
  district District? @relation(fields: [districtId], references: [id])

  @@unique([userId, provinceId, districtId])
  @@index([userId])
  @@map("user_service_areas")
}

model VendorWorkGroup {
  vendorId    String @map("vendor_id")
  workGroupId String @map("work_group_id")

  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  workGroup WorkGroup @relation(fields: [workGroupId], references: [id], onDelete: Cascade)

  @@id([vendorId, workGroupId])
  @@map("vendor_work_groups")
}

model BudgetVersion {
  id          String    @id @default(uuid())
  claimFileId String    @map("claim_file_id")
  versionNo   Int       @map("version_no")
  status      String    @default("draft")
  totalAmount Float     @default(0) @map("total_amount")
  notes       String?
  submittedAt DateTime? @map("submitted_at")
  approvedAt  DateTime? @map("approved_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  claimFile ClaimFile    @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  items     BudgetItem[]

  @@unique([claimFileId, versionNo])
  @@index([claimFileId])
  @@index([status])
  @@map("budget_versions")
}

model BudgetItem {
  id              String   @id @default(uuid())
  budgetVersionId String   @map("budget_version_id")
  vendorId        String?  @map("vendor_id")
  category        String
  description     String
  unit            String?
  quantity        Float    @default(1)
  unitPrice       Float    @map("unit_price")
  vatRate         Float    @default(18) @map("vat_rate")
  totalAmount     Float    @map("total_amount")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  budgetVersion BudgetVersion @relation(fields: [budgetVersionId], references: [id], onDelete: Cascade)
  vendor        Vendor?       @relation(fields: [vendorId], references: [id])

  @@index([budgetVersionId])
  @@map("budget_items")
}

model CostEntry {
  id                 String   @id @default(uuid())
  claimFileId        String   @map("claim_file_id")
  vendorId           String?  @map("vendor_id")
  category           String
  expenseCategoryId  String?  @map("expense_category_id")
  description        String
  amount             Float
  vatRate            Float    @default(18) @map("vat_rate")
  invoiceNo          String?  @map("invoice_no")
  entryDate          DateTime @map("entry_date")
  // P&L Faz 3 alanları
  source             String   @default("manual") // manual | vendor_statement | logo_erp | overhead_allocation
  sourceRefId        String?  @map("source_ref_id") // VendorStatementItem.id | OverheadAllocation.id
  isOverhead         Boolean  @default(false) @map("is_overhead") // false=değişken, true=sabit gider payı
  extraWorkItemId    String?  @map("extra_work_item_id") // ExtraWorkItem ile bağlantı (opsiyonel)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  claimFile       ClaimFile        @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  vendor          Vendor?          @relation(fields: [vendorId], references: [id])
  expenseCategory ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id])
  extraWorkItem   ExtraWorkItem?   @relation(fields: [extraWorkItemId], references: [id])
  overheadAllocation OverheadAllocation?

  @@index([claimFileId])
  @@index([expenseCategoryId])
  @@index([isOverhead])
  @@index([extraWorkItemId])
  @@map("cost_entries")
}

model ExpenseCategory {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  parentId  String?  @map("parent_id")
  level     Int      @default(1)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent      ExpenseCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    ExpenseCategory[] @relation("CategoryTree")
  costEntries CostEntry[]
  // P&L Faz 3
  overheadEntries MonthlyOverheadEntry[]

  @@index([parentId])
  @@map("expense_categories")
}

// ─── Faz 4: Departman Yönetimi ────────────────────────────────────────────────

model Department {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  description  String?
  color        String   @default("#6366F1")
  reportFormat String   @default("repair") @map("report_format")
  sortOrder    Int      @default(0) @map("sort_order")
  isSystem     Boolean  @default(false) @map("is_system")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  fileSubjects  DepartmentFileSubject[]
  fieldConfigs  ReportFieldConfig[]
  claimFiles    ClaimFile[]
  repairReports RepairReport[]

  @@index([status])
  @@map("departments")
}

model DepartmentFileSubject {
  id           String   @id @default(uuid())
  departmentId String   @map("department_id")
  code         String
  name         String
  isSystem     Boolean  @default(false) @map("is_system")
  sortOrder    Int      @default(0) @map("sort_order")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  claimFiles ClaimFile[]

  @@unique([departmentId, code])
  @@index([departmentId])
  @@map("department_file_subjects")
}

model ReportFieldConfig {
  id           String   @id @default(uuid())
  departmentId String   @map("department_id")
  reportFormat String   @map("report_format")
  fieldKey     String   @map("field_key")
  fieldLabel   String   @map("field_label")
  isRequired   Boolean  @default(false) @map("is_required")
  isVisible    Boolean  @default(true) @map("is_visible")
  sortOrder    Int      @default(0) @map("sort_order")
  updatedAt    DateTime @updatedAt @map("updated_at")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, reportFormat, fieldKey])
  @@index([departmentId])
  @@map("report_field_configs")
}

// ─── Faz 3: Onarım Raporu Modülü ──────────────────────────────────────────────

model WorkGroup {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  unit        String?
  sortOrder   Int      @default(0) @map("sort_order")
  isSystem    Boolean  @default(true) @map("is_system")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  reportItems      RepairReportItem[]
  targetMargin     TargetMargin?
  priceHistories   SupplierPriceHistory[]
  vendorWorkGroups VendorWorkGroup[]
  workSubGroups    WorkSubGroup[]
  statementItems   VendorStatementItem[]
  marketPrices     MarketPriceCatalog[]
  concentrationSnapshots VendorConcentrationSnapshot[]
  templateItems    ReportTemplateItem[]

  @@index([status])
  @@map("work_groups")
}

model TargetMargin {
  id           String  @id @default(uuid())
  workGroupId  String  @unique @map("work_group_id")
  minMarginPct Float   @map("min_margin_pct")
  warnBelowPct Float?  @map("warn_below_pct")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workGroup WorkGroup @relation(fields: [workGroupId], references: [id], onDelete: Cascade)

  @@map("target_margins")
}

model RepairReport {
  id                  String   @id @default(uuid())
  claimFileId         String   @map("claim_file_id")
  reportNo            String   @unique @map("report_no")
  reportType          String   @default("single") @map("report_type")
  reportDate          DateTime @map("report_date")
  inspectorName       String?  @map("inspector_name")
  reporterName        String?  @map("reporter_name")
  findingsText        String?  @map("findings_text")
  legalNotes          String?  @map("legal_notes")
  quickDamageTypes    String[] @default([]) @map("quick_damage_types")
  quickDamageSize     String?  @map("quick_damage_size")
  status              String   @default("draft")
  buildingDamageTotal Float    @default(0) @map("building_damage_total")
  goodsDamageTotal    Float    @default(0) @map("goods_damage_total")
  totalSupplierCost   Float    @default(0) @map("total_supplier_cost")
  totalSalesAmount    Float    @default(0) @map("total_sales_amount")
  grossProfit         Float    @default(0) @map("gross_profit")
  grossMarginPct      Float    @default(0) @map("gross_margin_pct")
  departmentId        String?  @map("department_id")
  expertOfficeId      String?  @map("expert_office_id")
  createdByUserId     String   @map("created_by_user_id")
  versionNo           Int      @default(1) @map("version_no")
  originalReportId    String?  @map("original_report_id")
  revisedAt           DateTime? @map("revised_at")
  revisedByUserId     String?  @map("revised_by_user_id")
  revisionCount       Int      @default(0) @map("revision_count")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  claimFile      ClaimFile          @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  createdBy      User               @relation("CreatedRepairReports", fields: [createdByUserId], references: [id])
  revisedBy      User?              @relation("RevisedRepairReports", fields: [revisedByUserId], references: [id])
  department     Department?        @relation(fields: [departmentId], references: [id])
  expertOffice   Customer?          @relation("ExpertOfficeReports", fields: [expertOfficeId], references: [id])
  originalReport RepairReport?      @relation("ReportVersions", fields: [originalReportId], references: [id])
  versions       RepairReport[]     @relation("ReportVersions")
  items          RepairReportItem[]
  images         ReportImage[]
  damageTypes    ReportDamageType[]
  approvalHistory ReportApprovalHistory[]
  externalApprovals ExternalApproval[]
  revisionRequests  ReportRevisionRequest[] @relation("ReportRevisionRequests")
  revisionAsNewReport ReportRevisionRequest[] @relation("RevisionNewReport")
  // P&L Faz 3
  fileRevenues   ClaimFileRevenue[]
  // Tedarikçi Sözleşmeleri
  vendorContracts VendorContract[]

  @@index([claimFileId])
  @@index([status])
  @@index([originalReportId])
  @@map("repair_reports")
}

model DamageTypeRepairTemplate {
  id                    String   @id @default(uuid())
  damageType            String   @map("damage_type")
  workSubGroupId        String   @map("work_sub_group_id")
  defaultQuantitySmall  Float?   @map("default_quantity_small")
  defaultQuantityMedium Float?   @map("default_quantity_medium")
  defaultQuantityLarge  Float?   @map("default_quantity_large")
  usageCount            Int      @default(0) @map("usage_count")
  sortOrder             Int      @default(0) @map("sort_order")
  createdBy             String?  @map("created_by")
  fileId                String?  @map("file_id")
  isGlobal              Boolean  @default(true) @map("is_global")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

