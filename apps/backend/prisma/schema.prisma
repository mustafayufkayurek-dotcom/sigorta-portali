  workGroupId       String   @map("work_group_id")
  jobDescription    String   @map("job_description")
  unit              String?
  supplierUnitPrice Float    @map("supplier_unit_price")
  salesUnitPrice    Float    @map("sales_unit_price")
  claimFileId       String   @map("claim_file_id")
  recordedAt        DateTime @default(now()) @map("recorded_at")

  workGroup WorkGroup @relation(fields: [workGroupId], references: [id], onDelete: Cascade)

  @@index([workGroupId, jobDescription])
  @@map("supplier_price_history")
}

// ─── Özellik: Tedarikçi Evrak Yönetimi ────────────────────────────────────────

model DocumentType {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isRequired  Boolean  @default(false) @map("is_required")
  sortOrder   Int      @default(0) @map("sort_order")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
