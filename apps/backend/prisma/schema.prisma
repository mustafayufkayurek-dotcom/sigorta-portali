model Payment {
  id              String   @id @default(uuid())
  claimFileId     String   @map("claim_file_id")
  paymentType     String   @map("payment_type")    // incoming | outgoing
  paymentDate     DateTime @map("payment_date")
  dueDate         DateTime? @map("due_date")
  amount          Float
  currency        String   @default("TRY")
  method          String                            // eft | havale | credit_card | cash | offset
  payerType       String   @map("payer_type")      // insurance_company | vendor | customer
  payerId         String?  @map("payer_id")
  invoiceId       String?  @map("invoice_id")
  referenceNo     String?  @map("reference_no")
  status          String   @default("completed")   // pending | completed | cancelled
  collectionChannel String? @map("collection_channel") // muhasebe | online_kart | manuel_onay
  collectionLinkId  String? @unique @map("collection_link_id")
  providerRef       String? @map("provider_ref")
  vendorStatementItemId String? @unique @map("vendor_statement_item_id")
  bankAccountId   String?  @map("bank_account_id")
  note            String?
  receiptStorageKey String?   @map("receipt_storage_key")
  receiptFileName   String?   @map("receipt_file_name")
  receiptMimeType   String?   @map("receipt_mime_type")
  receiptFileSize   Int?      @map("receipt_file_size")
  receiptUploadedAt DateTime? @map("receipt_uploaded_at")
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  claimFile   ClaimFile    @relation(fields: [claimFileId], references: [id], onDelete: Cascade)
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id])
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])
  createdBy   User         @relation("CreatedPayments", fields: [createdByUserId], references: [id])
  statementItems    VendorStatementItem[]
  statementReceipts VendorStatementReceipt[]
  // P&L Faz 3
  revenueRecords ClaimFileRevenue[] @relation("RevenuePayment")
  collectionLink PaymentCollectionLink? @relation(fields: [collectionLinkId], references: [id])
  vendorStatementItem VendorStatementItem? @relation("StatementItemPayment", fields: [vendorStatementItemId], references: [id])

  @@index([claimFileId])
  @@index([invoiceId])
  @@index([payerId, payerType, paymentType])
  @@index([status])
  @@index([dueDate])
  @@index([paymentType, status])
  @@map("payments")
}

