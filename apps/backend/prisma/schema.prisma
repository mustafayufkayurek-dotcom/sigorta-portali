  @@unique([damageType, workSubGroupId, fileId])
  @@index([damageType])
  @@index([usageCount(sort: Desc)])
  @@index([fileId])
  @@map("damage_type_repair_templates")
}

model ReportDamageType {
  id             String @id @default(uuid())
  reportId       String @map("report_id")
  damageTypeCode String @map("damage_type_code")
  damageTypeName String @map("damage_type_name")
  sortOrder      Int    @default(0) @map("sort_order")

  report RepairReport     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  items  RepairReportItem[]

  @@index([reportId])
  @@map("report_damage_types")
}

model RepairReportItem {
  id                String   @id @default(uuid())
  reportId          String   @map("report_id")
  workGroupId       String   @map("work_group_id")
  damageTypeId      String?  @map("damage_type_id")
  location          String?
  jobDescription    String   @map("job_description")
  description       String?
  quantity          Float    @default(1)
  unit              String   @default("adet")
  supplierUnitPrice Float    @default(0) @map("supplier_unit_price")
  salesUnitPrice    Float    @default(0) @map("sales_unit_price")
  supplierTotal     Float    @default(0) @map("supplier_total")
  salesTotal        Float    @default(0) @map("sales_total")
  marginPct         Float    @default(0) @map("margin_pct")
  sortOrder         Int      @default(0) @map("sort_order")
  metrajData        Json?    @map("metraj_data")
  pricingType       String   @default("unit") @map("pricing_type")
  lumpSumPrice      Float?   @map("lump_sum_price")
  materialIncluded  Boolean  @default(true) @map("material_included")
  laborIncluded     Boolean  @default(true) @map("labor_included")
  damageCategory    String   @default("bina") @map("damage_category")
  createdAt         DateTime @default(now()) @map("created_at")
