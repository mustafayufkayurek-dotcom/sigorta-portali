  materialCost        Float @default(0) @map("material_cost")
  communicationCost   Float @default(0) @map("communication_cost")
  otherVariableCost   Float @default(0) @map("other_variable_cost")
  totalVariableCost   Float @default(0) @map("total_variable_cost")
  overheadShare       Float @default(0) @map("overhead_share")
  totalCost           Float @default(0) @map("total_cost")
  netProfit           Float @default(0) @map("net_profit")
  netMarginPct        Float @default(0) @map("net_margin_pct")
  // Tahsilat kırılımı
  collectedFromInsurer Float @default(0) @map("collected_from_insurer")
  collectedFromInsured Float @default(0) @map("collected_from_insured")
  totalCollected       Float @default(0) @map("total_collected")
  outstandingBalance   Float @default(0) @map("outstanding_balance")

