# ── Şablon — gerçek şifre yazılmaz ──────────────────────────────────────────
# Kopyala: .env (lokal) veya sunucuda .env.production
# Bu dosya git’te durur. Canlı değerler yalnız VPS’tedir.

# Database
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/sigorta_hasar?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=meridyen_db
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Backend
NODE_ENV=development
BACKEND_PORT=3000
JWT_SECRET=CHANGE_ME_LONG_RANDOM
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_BLACKLIST_ENABLED=true
COOKIE_SECURE=false
CACHE_ENABLED=false
RATE_LIMIT_ENABLED=true
ENABLE_SWAGGER=false
SYSTEM_MAINTENANCE_MODE=false

# S3 / MinIO
STORAGE_PROVIDER=local
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=hasar-documents
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_PUBLIC_URL=http://localhost:9000

# Frontend / CORS (WEB_URL yazma Origin kapısını da besler)
WEB_URL=http://localhost:3001
APP_URL=http://localhost:3001
APP_PUBLIC_URL=http://localhost:3001
MOBILE_API_URL=http://localhost:3000/api/v1

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=CHANGE_ME
SMTP_FROM=noreply@example.com

# Microsoft Graph (giden mail — canlıda Mail.Send)
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_MAILBOX=

# Sentry
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_INSPECTION_REMINDER_ENABLED=false
# TELEGRAM_APPROVAL_DELAY_REMINDER_ENABLED=false
# TELEGRAM_INVOICE_REQUEST_NOTIFY_ENABLED=false

# PayTR
# ONLINE_CARD_COLLECTION_ENABLED=false
# PAYTR_MERCHANT_ID=
# PAYTR_MERCHANT_KEY=
# PAYTR_MERCHANT_SALT=
# PAYTR_TEST_MODE=1
# PAYTR_DEBUG_ON=0
# PAYTR_TIMEOUT_MINUTES=15

# SMS
# SMS_PROVIDER=
# SMS_API_KEY=
# SMS_API_SECRET=

# OpenAI (isteğe bağlı özellik)
# OPENAI_API_KEY=

# Maps (Acil alternatif öneri — ekranda Google yazılmaz)
# GOOGLE_PLACES_API_KEY=
# GOOGLE_MAPS_API_KEY=

# Recaptcha (varsa)
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=

# Logo Wing ERP
LOGO_INTEGRATION_ENABLED=false
LOGO_API_BASE_URL=http://192.168.1.100:9090
LOGO_API_CLIENT_ID=
LOGO_API_CLIENT_SECRET=
LOGO_API_USERNAME=
LOGO_API_PASSWORD=
LOGO_FIRM_NO=1
LOGO_COMPANY_CODE_PREFIX=SHS_
LOGO_TOKEN_CACHE_TTL_MINUTES=55

# Web build (Docker ARG / image)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_REMEMBER_ME_MAX_DAYS=7
