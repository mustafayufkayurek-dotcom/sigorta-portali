# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sigorta_hasar?schema=public
REDIS_URL=redis://localhost:6379

# Backend
BACKEND_PORT=3000
JWT_SECRET=your-secret-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# S3 Compatible Storage
# Development için: STORAGE_PROVIDER=local (./uploads/ klasörü kullanılır)
# Production için: STORAGE_PROVIDER=s3
STORAGE_PROVIDER=local

# S3 / DigitalOcean Spaces / MinIO konfigürasyonu
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=hasar-documents

# Production örneği (DigitalOcean Spaces):
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=https://ams3.digitaloceanspaces.com
# S3_REGION=ams3
# S3_ACCESS_KEY=your_do_spaces_access_key
# S3_SECRET_KEY=your_do_spaces_secret_key
# S3_BUCKET=sigorta-hasar

# Frontend URLs
WEB_URL=http://localhost:3001
MOBILE_API_URL=http://localhost:3000/api/v1

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@example.com

# Dış Onay
APP_PUBLIC_URL=http://localhost:3001

# ─── Logo Wing ERP Entegrasyonu ──────────────────────────────────────────────
LOGO_INTEGRATION_ENABLED=false
LOGO_API_BASE_URL=http://192.168.1.100:9090
LOGO_API_CLIENT_ID=your_logo_client_id
LOGO_API_CLIENT_SECRET=your_logo_client_secret
LOGO_API_USERNAME=logo_api_user
LOGO_API_PASSWORD=logo_api_password
LOGO_FIRM_NO=1
LOGO_COMPANY_CODE_PREFIX=SHS_
LOGO_TOKEN_CACHE_TTL_MINUTES=55

APP_URL=http://localhost:3001
