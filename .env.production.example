# =============================================================================
#  SİGORTA HASAR SİSTEMİ — Production Ortam Değişkenleri
# =============================================================================
#
# KULLANIM:
#   1. Bu dosyayı kopyalayın: cp .env.production.example .env.production
#   2. Aşağıdaki değerleri doldurun (BURAYA_... ile başlayanları mutlaka değiştirin!)
#   3. Dosyayı kaydedin
#
# DİKKAT: .env.production dosyasını asla Git'e yüklemeyin!
#          .gitignore dosyasında zaten engelleniyor.
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# ALAN ADI (DOMAIN)
# ─────────────────────────────────────────────────────────────────────────────

# Sitenizin alan adı — başında https:// veya www OLMADAN yazın
# Örnek: sigorta.sirketim.com.tr   veya   hasar.sirketim.com
DOMAIN=alanadi.com.tr


# ─────────────────────────────────────────────────────────────────────────────
# VERİTABANI (PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────

# Veritabanı kullanıcı adı — istediğiniz bir isim yazın (boşluk ve Türkçe karakter olmadan)
POSTGRES_USER=sigorta_user

# Veritabanı şifresi — EN AZ 16 karakter, harf+rakam+özel karakter kullanın
# Güçlü şifre üretmek için terminalde şunu çalıştırın: openssl rand -base64 24
POSTGRES_PASSWORD=BURAYA_GUCLU_SIFRE_YAZIN

# Veritabanı adı — değiştirmenize gerek yok
POSTGRES_DB=sigorta_hasar

# Veritabanı bağlantı adresi — DEĞİŞTİRMEYİN (otomatik oluşturuluyor)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public


# ─────────────────────────────────────────────────────────────────────────────
# REDIS (Oturum ve Önbellek)
# ─────────────────────────────────────────────────────────────────────────────

# Redis şifresi — güçlü bir şifre kullanın
# Üretmek için: openssl rand -base64 24
REDIS_PASSWORD=BURAYA_REDIS_SIFRESI_YAZIN

# Redis bağlantı adresi — DEĞİŞTİRMEYİN
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379


# ─────────────────────────────────────────────────────────────────────────────
# GÜVENLİK (JWT Token)
# ─────────────────────────────────────────────────────────────────────────────

# JWT gizli anahtarı — kullanıcı oturumlarını şifreler, ÇOK ÖNEMLİ!
# Üretmek için terminalde şunu çalıştırın ve çıkan metni OLDUĞU GİBİ yapıştırın:
#   openssl rand -hex 32
# Örnek çıktı şöyle görünür: a3f8c2d1e4b5a6f7c8d9e0a1b2c3d4e5...
JWT_SECRET=BURAYA_OPENSSL_RAND_HEX_32_CIKTISINI_YAPISTIRIN

# Token süreleri — değiştirmenize gerek yok
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Ortam değişkeni — DEĞİŞTİRMEYİN
NODE_ENV=production

# Backend port numarası — değiştirmenize gerek yok
BACKEND_PORT=3000


# ─────────────────────────────────────────────────────────────────────────────
# DOSYA DEPOLAMA (MinIO)
# ─────────────────────────────────────────────────────────────────────────────

# Dosya depolama yöntemi — production'da s3 olarak bırakın
STORAGE_PROVIDER=s3

# MinIO yönetici kullanıcı adı — istediğiniz bir isim yazın
MINIO_ROOT_USER=sigorta_minio

# MinIO yönetici şifresi — EN AZ 8 karakter
# Üretmek için: openssl rand -base64 16
MINIO_ROOT_PASSWORD=BURAYA_MINIO_SIFRESI_YAZIN

# MinIO bağlantı ayarları — DEĞİŞTİRMEYİN
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=${MINIO_ROOT_USER}
S3_SECRET_KEY=${MINIO_ROOT_PASSWORD}
S3_BUCKET=hasar-documents


# ─────────────────────────────────────────────────────────────────────────────
# URL AYARLARI
# ─────────────────────────────────────────────────────────────────────────────

# Frontend sitenizin tam adresi (başında https:// ile, sonunda / olmadan)
WEB_URL=https://alanadi.com.tr

# API'nin tam adresi — Next.js bu adresi kullanarak backend'e bağlanır
# Nginx /api yolunu backend'e yönlendirdiği için genellikle /api/v1 eklenir
NEXT_PUBLIC_API_URL=https://alanadi.com.tr/api/v1

# Dış kullanıcılara (eksper, tedarikçi) gönderilen linklerde kullanılan adres
APP_PUBLIC_URL=https://alanadi.com.tr

# Uygulama URL'i (WEB_URL ile aynı olabilir)
APP_URL=https://alanadi.com.tr


# ─────────────────────────────────────────────────────────────────────────────
# E-POSTA (SMTP)
# ─────────────────────────────────────────────────────────────────────────────
#
# Hangi mail sağlayıcısını kullanacaksınız? Aşağıdan seçin:
#
# SEÇENEK A — Hosting firmanızın maili (Turhost, Natro, vb.):
#   SMTP_HOST=mail.alanadi.com.tr
#   SMTP_PORT=587
#   SMTP_USER=noreply@alanadi.com.tr
#   SMTP_PASS=mail_panelinizden_aldığınız_şifre
#
# SEÇENEK B — Gmail (yalnızca test için):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=sirket@gmail.com
#   SMTP_PASS=Gmail_Uygulama_Şifresi  (Gmail > Güvenlik > 2 Adımlı > Uygulama Şifresi)
#
# SEÇENEK C — SendGrid (ücretsiz 100 mail/gün, önerilir):
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASS=SG.xxxx... (SendGrid API Key)
#
# SEÇENEK D — Yandex 360:
#   SMTP_HOST=smtp.yandex.com
#   SMTP_PORT=587

SMTP_HOST=mail.alanadi.com.tr
SMTP_PORT=587
SMTP_USER=noreply@alanadi.com.tr
SMTP_PASS=BURAYA_MAIL_SIFRESI_YAZIN
SMTP_FROM=noreply@alanadi.com.tr

# Akıllı fiş/fatura okuma (OpenAI Vision — opsiyonel)
# OPENAI_API_KEY=sk-...


# ─────────────────────────────────────────────────────────────────────────────
# YEDEKLEME AYARLARI
# ─────────────────────────────────────────────────────────────────────────────

# Yedeklerin kaydedileceği klasör — sunucuda bu klasör otomatik oluşturulur
BACKUP_DIR=/var/backups/sigorta

# PostgreSQL container adı — DEĞİŞTİRMEYİN
POSTGRES_CONTAINER=sigorta-postgres


# ─────────────────────────────────────────────────────────────────────────────
# WHATSAPP API (İLERİDE KULLANILACAK — ŞİMDİ BOŞ BIRAKABİLİRSİNİZ)
# ─────────────────────────────────────────────────────────────────────────────
#
# Şu an aktif değil, ileride entegre edilecek.
# Twilio veya Meta Cloud API kullanılacak.
#
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886


# ─────────────────────────────────────────────────────────────────────────────
# LOGO WING ERP ENTEGRASYONU (OPSİYONEL)
# ─────────────────────────────────────────────────────────────────────────────
#
# Logo ERP kullanmıyorsanız: LOGO_INTEGRATION_ENABLED=false bırakın
# Diğer alanları boş bırakabilirsiniz

LOGO_INTEGRATION_ENABLED=false
LOGO_API_BASE_URL=http://192.168.1.100:9090
LOGO_API_CLIENT_ID=
LOGO_API_CLIENT_SECRET=
LOGO_API_USERNAME=
LOGO_API_PASSWORD=
LOGO_FIRM_NO=1
LOGO_COMPANY_CODE_PREFIX=SHS_
LOGO_TOKEN_CACHE_TTL_MINUTES=55


# ─────────────────────────────────────────────────────────────────────────────
# ONLINE KART TAHSİLAT (PayTR)
# ─────────────────────────────────────────────────────────────────────────────
#
# PayTR Mağaza Paneli > Destek & Kurulum > Entegrasyon Bilgileri
# Bildirim URL (callback): https://APP_DOMAIN/api/v1/webhooks/payments/paytr
#
# Canlıya almadan önce test modunda doğrulayın; sonra ONLINE_CARD_COLLECTION_ENABLED=true

ONLINE_CARD_COLLECTION_ENABLED=false
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1
PAYTR_DEBUG_ON=1
PAYTR_TIMEOUT_MINUTES=30
APP_PUBLIC_URL=https://app.meridyen-tr.com


# ─────────────────────────────────────────────────────────────────────────────
# HATA TAKİP (OPSİYONEL — Sentry)
# ─────────────────────────────────────────────────────────────────────────────
#
# Uygulamadaki hataları takip etmek için Sentry kullanılabilir (ücretsiz plan var)
# https://sentry.io adresinden ücretsiz hesap açıp DSN alabilirsiniz
# Kullanmayacaksanız boş bırakın

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
